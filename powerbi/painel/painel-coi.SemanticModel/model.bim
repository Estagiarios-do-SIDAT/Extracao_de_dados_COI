      {
        "name": "Filtro Período",
        "lineageTag": "573cbac2-217a-e70c-4bd7-91bbfcc51dd9",
        "description": "Opções do filtro Mês/Ano das páginas Visão Geral e Por Tipo: Todos os meses (todos os dias carregados) ou um mês. Filtra só o Calendário COI.",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Data",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Data]",
            "summarizeBy": "none",
            "lineageTag": "d3a0de35-00c7-a539-71b9-65f2aab6d481",
            "formatString": "dd/mm/yyyy",
            "isHidden": true
          },
          {
            "type": "calculatedTableColumn",
            "name": "Período",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Período]",
            "summarizeBy": "none",
            "lineageTag": "a8293523-4a66-6423-1aa8-af02daeb90dc",
            "sortByColumn": "Ordem"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Ordem",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Ordem]",
            "summarizeBy": "none",
            "lineageTag": "e027a49b-ebcd-353b-ab49-eba39d1c2b57",
            "formatString": "0",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Filtro Período",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "VAR Meses =\n    SELECTCOLUMNS ( 'Calendário COI', \"Data\", 'Calendário COI'[Data], \"Período\", 'Calendário COI'[Mês/Ano],\n        \"Ordem\", 1000000 - 'Calendário COI'[AnoMes] )\nVAR Todos =\n    SELECTCOLUMNS ( 'Calendário COI', \"Data\", 'Calendário COI'[Data], \"Período\", \"Todos os meses\", \"Ordem\", 0 )\nRETURN\n    UNION ( Todos, Meses )"
            }
          }
        ]
      },
      {
        "name": "Medidas COI",
        "lineageTag": "ce53a33e-f86f-591e-0745-affdeaae8c3f",
        "description": "Medidas do painel do COI.",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Coluna",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Coluna]",
            "isHidden": true,
            "summarizeBy": "none",
            "lineageTag": "2beb2f15-c928-f497-52fc-d7b91184b964"
          }
        ],
        "partitions": [
          {
            "name": "Medidas COI",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ROW ( \"Coluna\", 0 )"
            }
          }
        ],
        "measures": [
          {
            "name": "Registrados",
            "expression": "COALESCE ( COUNTROWS ( 'Chamados Registrados' ), 0 )",
            "formatString": "#,0",
            "lineageTag": "fcebe81b-1864-c428-376b-8be73e014aaf",
            "description": "Chamados que entraram no COI, pela data de registro no COI."
          },
          {
            "name": "Encerrados",
            "expression": "COALESCE ( COUNTROWS ( 'Chamados Encerrados' ), 0 )",
            "formatString": "#,0",
            "lineageTag": "28bff76b-ea24-cc39-a711-cce3cf2c592e",
            "description": "Chamados encerrados pelo COI, pela data de encerramento."
          },
          {
            "name": "Registrados por tipo",
            "expression": "COUNTROWS ( 'Chamados Registrados' )",
            "formatString": "#,0",
            "lineageTag": "f73ca983-730e-62c5-cbbb-c36a912869ce",
            "description": "Registrados sem completar com zero: nos gráficos de Por Tipo, meses fora do filtro não aparecem."
          },
          {
            "name": "Encerrados por tipo",
            "expression": "COUNTROWS ( 'Chamados Encerrados' )",
            "formatString": "#,0",
            "lineageTag": "b3cf2ad4-6e06-6e5d-61ee-e7f938b5bf8f",
            "description": "Encerrados sem completar com zero: nos gráficos de Por Tipo, meses fora do filtro não aparecem."
          },
          {
            "name": "Registrados no dia",
            "expression": "SUM ( 'Movimentação Diária'[Registrados] )",
            "formatString": "#,0",
            "lineageTag": "a3a4576d-ff51-203e-e8ea-0ea4b5e2a1f8",
            "description": "Série diária de Registrados (Visão Geral, gráfico Ano › Mês › Dia)."
          },
          {
            "name": "Encerrados no dia",
            "expression": "SUM ( 'Movimentação Diária'[Encerrados] )",
            "formatString": "#,0",
            "lineageTag": "a813f471-ce0e-8dab-a415-c2797efaccd8",
            "description": "Série diária de Encerrados (Visão Geral, gráfico Ano › Mês › Dia)."
          },
          {
            "name": "Registrados por hora",
            "expression": "SUM ( 'Movimentação por Hora'[Registrados] )",
            "formatString": "#,0",
            "lineageTag": "8b267317-d4da-d3b0-22f8-b9f0b82e713f"
          },
          {
            "name": "Encerrados por hora",
            "expression": "SUM ( 'Movimentação por Hora'[Encerrados] )",
            "formatString": "#,0",
            "lineageTag": "c8a0414f-bc77-8409-263e-1a58a99d2489"
          },
          {
            "name": "Registrados por membro",
            "expression": "SUM ( 'Movimentação por Membro'[Registrados] )",
            "formatString": "#,0",
            "lineageTag": "1f2a617e-8045-5e4d-4ce1-2d4c454d537f",
            "description": "Chamados registrados pela conta (quem abriu)."
          },
          {
            "name": "Encerrados por membro",
            "expression": "SUM ( 'Movimentação por Membro'[EncerradosComoResponsavel] )",
            "formatString": "#,0",
            "lineageTag": "2c95fd69-74e0-60f8-725c-096fbf3f838c",
            "description": "Critério do fornecedor: encerramentos atribuídos ao responsável do chamado (EncerradosComoResponsavel). Não usa a coluna Encerrados (quem executou o encerramento)."
          },
          {
            "name": "Pesquisas solicitadas",
            "expression": "COALESCE ( CALCULATE ( COUNTROWS ( 'Pesquisas de Satisfação' ), KEEPFILTERS ( 'Pesquisas de Satisfação'[PesquisaSolicitada] = \"Sim\" ) ), 0 )",
            "formatString": "#,0",
            "lineageTag": "0ef2038b-2bef-5733-d3e6-5222a33a4b78",
            "description": "Chamados encerrados com pedido de pesquisa registrado no SDM."
          },
          {
            "name": "Pesquisas respondidas",
            "expression": "COALESCE ( CALCULATE ( COUNTROWS ( 'Pesquisas de Satisfação' ), KEEPFILTERS ( 'Pesquisas de Satisfação'[StatusSatisfacao] = \"Com satisfação\" ) ), 0 )",
            "formatString": "#,0",
            "lineageTag": "3673ddf7-361c-0547-ed36-d84a5898352a",
            "description": "Chamados encerrados com pesquisa respondida (ao menos uma pergunta). É a regra validada do COI."
          },
          {
            "name": "Última atualização",
            "expression": "FORMAT ( MAX ( 'Última Atualização'[UltimaAtualizacao] ), \"dd/mm/yyyy hh:nn\" )",
            "lineageTag": "e8be36cd-a6f6-4569-914e-9a10d7d90faa",
            "description": "Data e hora (Brasília) da última atualização dos dados, vinda da consulta Última Atualização."
          },
          {
            "name": "Período exibido",
            "expression": "VAR Meses = DISTINCTCOUNT ( 'Calendário COI'[AnoMes] )\nVAR Primeiro = CALCULATE ( MIN ( 'Calendário COI'[Mês/Ano] ), TOPN ( 1, VALUES ( 'Calendário COI'[AnoMes] ), 'Calendário COI'[AnoMes], ASC ) )\nVAR Ultimo = CALCULATE ( MIN ( 'Calendário COI'[Mês/Ano] ), TOPN ( 1, VALUES ( 'Calendário COI'[AnoMes] ), 'Calendário COI'[AnoMes], DESC ) )\nRETURN\n    IF ( Meses = 1, \"Mês: \" & Ultimo, \"Todos os meses: \" & Primeiro & \" a \" & Ultimo )",
            "lineageTag": "a4d6a9dd-7770-3c24-391f-b8373574a878",
            "description": "Texto do mês selecionado, ou do intervalo de meses, para os títulos dos visuais."
          },
          {
            "name": "AnoMes exibido",
            "expression": "MAX ( 'Calendário COI'[AnoMes] )",
            "formatString": "0",
            "lineageTag": "204a6bfd-984e-9c78-afa0-6f5169fb0fa4",
            "description": "Mês das páginas de mês único: o mês selecionado ou, sem seleção, o último mês carregado (nunca todos os meses).",
            "isHidden": true
          },
          {
            "name": "Mês exibido",
            "expression": "VAR m = [AnoMes exibido] RETURN CALCULATE ( MIN ( 'Calendário COI'[Mês/Ano] ), 'Calendário COI'[AnoMes] = m )",
            "lineageTag": "2d7f8d84-d1ee-119f-7694-307c006a937b",
            "description": "Mês/Ano das páginas de mês único (Por Hora, Por Membro, Satisfação)."
          },
          {
            "name": "Registrados por hora no mês",
            "expression": "VAR m = [AnoMes exibido] RETURN CALCULATE ( [Registrados por hora], 'Calendário COI'[AnoMes] = m )",
            "formatString": "#,0",
            "lineageTag": "fee72cf9-5157-8985-c26b-443a42029ec6",
            "description": "Registrados por hora no mês exibido: nunca soma vários meses."
          },
          {
            "name": "Encerrados por hora no mês",
            "expression": "VAR m = [AnoMes exibido] RETURN CALCULATE ( [Encerrados por hora], 'Calendário COI'[AnoMes] = m )",
            "formatString": "#,0",
            "lineageTag": "df036af5-9ab4-146a-75b6-17df3f1b26cc",
            "description": "Encerrados por hora no mês exibido: nunca soma vários meses."
          },
          {
            "name": "Registrados por membro no mês",
            "expression": "VAR m = [AnoMes exibido] RETURN CALCULATE ( [Registrados por membro], 'Calendário COI'[AnoMes] = m )",
            "formatString": "#,0",
            "lineageTag": "5c92a2dd-df21-358f-bfb5-56b097b8c3b8",
            "description": "Registrados por membro no mês exibido."
          },
          {
            "name": "Encerrados por membro no mês",
            "expression": "VAR m = [AnoMes exibido] RETURN CALCULATE ( [Encerrados por membro], 'Calendário COI'[AnoMes] = m )",
            "formatString": "#,0",
            "lineageTag": "5f9d70c2-ba9c-49e5-cb69-0622edafdaba",
            "description": "Encerrados por membro no mês exibido, pelo critério do fornecedor (EncerradosComoResponsavel)."
          },
          {
            "name": "Pesquisas respondidas no mês",
            "expression": "VAR m = [AnoMes exibido] RETURN CALCULATE ( [Pesquisas respondidas], 'Calendário COI'[AnoMes] = m )",
            "formatString": "#,0",
            "lineageTag": "aad5cca7-d16c-e82e-aa8e-e12a991e0f3f",
            "description": "Chamados com StatusSatisfacao = Com satisfação no mês exibido: a mesma população da tabela da página Satisfação."
          },
          {
            "name": "Avaliação no mês exibido",
            "expression": "VAR m = [AnoMes exibido] RETURN IF ( SELECTEDVALUE ( 'Pesquisas de Satisfação'[Ano] ) * 100 + SELECTEDVALUE ( 'Pesquisas de Satisfação'[Mes] ) = m, 1, 0 )",
            "formatString": "0",
            "lineageTag": "b8318df7-fda0-bad4-a6e4-760ed47a5d20",
            "description": "1 para o chamado encerrado no mês exibido; filtro da tabela da página Satisfação.",
            "isHidden": true
          },
          {
            "name": "Mensagem sem avaliações",
            "expression": "IF ( [Pesquisas respondidas no mês] = 0, \"Nenhuma avaliação registrada em \" & [Mês exibido] & \".\", \"\" )",
            "lineageTag": "1c908370-a5bb-ea57-e63e-53e611e0686c",
            "isHidden": true
