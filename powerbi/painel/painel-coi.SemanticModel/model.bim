        "partitions": [
          {
            "name": "Movimentação por Membro",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Sql = \"USE mdb;#(lf)SET NOCOUNT ON;#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- VERSAO POWER BI de queries/consulta_coi_registrados_encerrados_por_membro.sql#(lf)--#(lf)-- A regra e a da consulta de /queries, que e a fonte de verdade. Este arquivo#(lf)-- e o texto dela sem alteracao, exceto pelas adaptacoes abaixo, marcadas no#(lf)-- corpo com [POWER BI]. Se esta versao e a fonte divergirem, vale a fonte.#(lf)--#(lf)-- Adaptacoes:#(lf)--   - periodo automatico: os meses de calendario COMPLETOS anteriores ao mes#(lf)--     corrente - ate @PBI_QuantidadeMeses, a partir de @PBI_InicioMinimoBR -,#(lf)--     no lugar das datas digitadas;#(lf)--   - saida: a fonte ja devolve um unico result set, que sai sem alteracao.#(lf)--#(lf)-- Power BI: conector SQL Server, banco mdb, modo Importacao, este arquivo#(lf)-- inteiro no campo Instrucao SQL, Adicionar colunas de relacao desmarcado.#(lf)-- Somente leitura. Batch unico, sem GO.#(lf)--------------------------------------------------------------------------------#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- [POWER BI] PERIODO AUTOMATICO#(lf)--#(lf)-- A fonte recebe o periodo digitado, em meses de calendario com fim EXCLUSIVO.#(lf)-- Aqui ele e calculado a cada atualizacao, na mesma forma:#(lf)--#(lf)--     fim    (exclusivo) = dia 1 do mes corrente, 00:00:00, horario do Brasil#(lf)--     inicio (inclusivo) = @PBI_QuantidadeMeses meses antes do fim, mas nunca#(lf)--                          antes de @PBI_InicioMinimoBR#(lf)--#(lf)-- Entram so meses COMPLETOS: o mes em andamento fica de fora. As consultas do#(lf)-- painel usam todas este MESMO periodo, para que o filtro Mes/Ano enxergue os#(lf)-- mesmos meses em todas as paginas.#(lf)--#(lf)-- @PBI_InicioMinimoBR = 01/03/2026: mes em que o novo COI passou a usar o#(lf)-- codigo de fornecedor atual, o grupo alvo de Encerrados (@COI_Novo). Marco#(lf)-- entra INTEIRO. Antes dele, os encerramentos sao do grupo antigo - outro#(lf)-- contrato, que a regra de Encerrados nao soma -, e o painel mostraria meses#(lf)-- sem Encerrados ao lado de meses com Registrados. O piso so muda se mudar o#(lf)-- grupo alvo.#(lf)--#(lf)-- @PBI_QuantidadeMeses vem do parametro QtdMesesCompletosCOI do Power Query,#(lf)-- o MESMO nas seis consultas. O Power Query troca o 12 da linha abaixo pela#(lf)-- referencia @QtdMesesCompletosCOI e executa o lote com esse parametro SQL#(lf)-- (Value.NativeQuery, sp_executesql); ver powerbi/powerbi-query.md, secao 3.#(lf)-- O 12 vale so quando o arquivo roda fora do Power BI. Nao mude o texto da#(lf)-- linha: o Power Query a localiza por ele e falha se nao a encontrar.#(lf)--------------------------------------------------------------------------------#(lf)DECLARE @PBI_QuantidadeMeses int = 12;#(lf)DECLARE @PBI_InicioMinimoBR datetime2(0) = '2026-03-01 00:00:00';#(lf)#(lf)IF @PBI_QuantidadeMeses IS NULL OR @PBI_QuantidadeMeses < 1#(lf)    THROW 50001, N'[POWER BI] QtdMesesCompletosCOI deve ser um inteiro positivo.', 1;#(lf)#(lf)DECLARE @PBI_HojeBR date =#(lf)    CONVERT(date, DATEADD(HOUR, -3, SYSUTCDATETIME()));#(lf)DECLARE @PBI_FimBR datetime2(0) =#(lf)    CONVERT(datetime2(0), DATEFROMPARTS(YEAR(@PBI_HojeBR), MONTH(@PBI_HojeBR), 1));#(lf)-- Fim e piso sao dias 1: \"\"n meses antes do fim depois do piso\"\" equivale a#(lf)-- \"\"n menor que os meses entre piso e fim\"\", e esta forma nao estoura o#(lf)-- DATEADD quando n e muito grande.#(lf)DECLARE @PBI_InicioBR datetime2(0) =#(lf)    CASE WHEN @PBI_QuantidadeMeses < DATEDIFF(MONTH, @PBI_InicioMinimoBR, @PBI_FimBR)#(lf)         THEN DATEADD(MONTH, -@PBI_QuantidadeMeses, @PBI_FimBR)#(lf)         ELSE @PBI_InicioMinimoBR END;#(lf)#(lf)#(lf)/*#(lf)================================================================================#(lf)COI - REGISTRADOS x ENCERRADOS pelo COI, por MEMBRO e por mes#(lf)================================================================================#(lf)#(lf)Para cada mes do periodo e cada pessoa ou conta, quantos chamados ela#(lf)REGISTROU e quantos ela ENCERROU - as duas series lado a lado, com a#(lf)classificacao da conta (membro do grupo COI, pessoa fora do grupo, conta#(lf)tecnica/automacao).#(lf)#(lf)Saida: UM unico result set.#(lf)    Ano, Mes, MesAno, MembroUUID, MembroUserID, Membro, TipoConta,#(lf)    Registrados, Encerrados, EncerradosComoResponsavel#(lf)#(lf)    Uma linha por (mes, conta) com ao menos um registro ou um encerramento.#(lf)    Com @MostrarDiagnostico = 1, um segundo result set lista, chamado a#(lf)    chamado, a quem cada encerramento foi atribuido e por qual evento.#(lf)#(lf)AS DUAS SERIES SAO CALCULADAS SEPARADAMENTE, cada uma com a sua regra e a sua#(lf)data - exatamente como em consulta_coi_registrados_encerrados_diario.sql, da#(lf)qual esta consulta e a contrapartida \"\"por membro\"\":#(lf)#(lf)    Registrados  populacao: regra canonica de Registrados (bloco abaixo,#(lf)                 IDENTICO byte a byte ao das consultas de Registrados).#(lf)                 Data: DataRegistroCOI.#(lf)                 Atribuicao: quem REGISTROU = call_req.log_agent (o campo#(lf)                 \"\"Relatado por\"\"), a mesma definicao de RegistradorUUID no#(lf)                 detalhe e de consulta_coi_registrados_por_registrador.sql.#(lf)                 Num chamado TRANSFERIDO para o COI, quem abriu e de outra fila;#(lf)                 por isso a coluna TipoConta existe.#(lf)#(lf)    Encerrados   populacao: regra oficial de Encerrados, LITERALMENTE a de#(lf)                 consulta_coi_encerrados.sql (close_date no periodo, I/R,#(lf)                 CL/CLUNRSLV, grupo ATUAL = @COI_GrupoAlvo valido).#(lf)                 Data: close_date.#(lf)                 Atribuicao: duas, nas duas colunas abaixo - pelo RESPONSAVEL#(lf)                 (EncerradosComoResponsavel, o indicador) e por quem#(lf)                 EXECUTOU o encerramento (Encerrados, auditoria).#(lf)#(lf)    EncerradosComoResponsavel e a mesma populacao de Encerrados atribuida pelo#(lf)    RESPONSAVEL (call_req.assignee, a coluna [Responsável] de#(lf)    consulta_coi_encerrados.sql) - a convencao da \"\"Consulta para Auditoria\"\" e#(lf)    da tabela por analista do relatorio do fornecedor (Historico Mestre, secoes#(lf)    56 e 62). E A SERIE DO INDICADOR: a pagina Por Membro do painel usa#(lf)    EncerradosComoResponsavel, com o rotulo \"\"Encerrados\"\". Conferido contra os#(lf)    relatorios do fornecedor de 09/03 a 31/03/2026 e de junho/2026: mesmo#(lf)    responsavel em 471 de 471 e 612 de 612 chamados comuns, e a tabela por#(lf)    analista reproduzida nome a nome. A coluna Encerrados (quem executou o#(lf)    encerramento) fica para auditoria e comparacao e nao alimenta o indicador.#(lf)#(lf)    Um mesmo chamado pode contar em Registrados para uma pessoa e em#(lf)    Encerrados para outra, so numa das series, ou em nenhuma. As somas de cada#(lf)    serie fecham com o detalhe correspondente para o mesmo periodo:#(lf)        SUM(Registrados) = linhas de consulta_coi_registrados_detalhe.sql#(lf)        SUM(Encerrados)  = linhas de consulta_coi_encerrados.sql#(lf)        SUM(EncerradosComoResponsavel) = linhas de consulta_coi_encerrados.sql#(lf)#(lf)QUEM EXECUTOU O ENCERRAMENTO (coluna Encerrados, auditoria) - e por que NAO e#(lf)o \"\"Responsavel\"\"#(lf)#(lf)    call_req.assignee (a coluna [Responsável] de consulta_coi_encerrados.sql) e#(lf)    o responsavel ATUAL do chamado, nao quem executou o encerramento. Medido em#(lf)    01/04/2026 a 01/10/2026 (grupo COI_Novo, 3.558 encerrados), o autor do#(lf)    evento que encerrou difere do assignee em 755 deles (21%):#(lf)    nos encerramentos automaticos depois da homologacao, por exemplo, o#(lf)    assignee continua sendo o analista e quem fechou foi a conta de automacao.#(lf)#(lf)    O SDM registra o encerramento de duas formas, medidas na mesma amostra:#(lf)      - evento CL no proprio segundo do close_date (\"\"Status alterado de ... para#(lf)        'Resolvido, concluido'\"\" ou \"\"... 'Nao resolvido, fechado'\"\"): 1.062#(lf)        chamados;#(lf)      - evento SOLN (registro da solucao) de 1 segundo a alguns minutos antes do#(lf)        close_date, sem evento de status no fechamento: cerca de 2.250 chamados.#(lf)#(lf)    REGRA: o encerramento e atribuido ao analista (act_log.analyst) do ULTIMO#(lf)    evento de status ou de solucao do chamado - tipos CL, ST, CLREQ, RE, RO,#(lf)    SOLN - gravado ATE o close_date. Desempate determinístico: system_time#(lf)    decrescente e act_log.id decrescente (o id e a ordem de gravacao no SDM).#(lf)    O diagnostico mostra o tipo do evento usado e a distancia ate o close_date.#(lf)#(lf)    ISTO NAO E A REGRA DE ENCERRADOS QUE A SECAO 62 DO HISTORICO DERRUBOU. Aquela#(lf)    usava o act_log para decidir a POPULACAO (o grupo no encerramento) e foi#(lf)    substituida pelo grupo ATUAL. Aqui a populacao continua sendo a da regra#(lf)    oficial; o act_log so diz a QUEM cada encerramento ja apurado e atribuido,#(lf)    sem parse de texto (le apenas type, system_time e analyst).#(lf)#(lf)TipoConta - classificacao da conta, fora de qualquer contagem#(lf)    'Conta técnica / automação'  userid usr_automacoes ou sesuc_auto, ou userid#(lf)                                 ou nome contendo SERVICEDESK / SERVICE DESK -#(lf)                                 as tres contas tecnicas que o projeto ja#(lf)                                 reconhece (consulta_coi_registrados_total_com_tecnicos.sql)#(lf)    'Membro do grupo COI'        pessoa que consta HOJE em grpmem de @COI_Novo#(lf)                                 ou de @COI_Antigo#(lf)    'Fora do grupo COI'          pessoa que nao consta hoje em nenhum dos dois#(lf)    'Não identificado'           chamado sem log_agent, encerramento sem evento,#(lf)                                 encerramento sem responsavel (assignee nulo),#(lf)                                 ou UUID sem contato em ca_contact#(lf)    LIMITE: grpmem guarda a composicao ATUAL. Quem saiu da equipe aparece como#(lf)    'Fora do grupo COI' nos meses em que ainda era membro, assim como analistas#(lf)    que o relatorio do fornecedor lista no COI e que nao constam hoje em#(lf)    grpmem. TipoConta nao filtra o indicador.#(lf)#(lf)CONTAGEM POR CHAMADO#(lf)    Cada chamado entra UMA vez em cada serie: #Registrados e #EncerradosCOI tem#(lf)    uma linha por chamado, e cada linha recebe UMA conta (log_agent, ou o#(lf)    analista de UM evento escolhido por TOP (1)). A soma das contas e o total.#(lf)#(lf)O BLOCO CANONICO#(lf)    O bloco canonico de Registrados, entre os seus marcadores de inicio e de#(lf)    fim, e copiado sem alteracao de consulta_coi_registrados_encerrados_diario.sql. O texto#(lf)    interno do bloco ainda cita \"\"SETE consultas\"\": esta e a oitava a usa-lo, e o#(lf)    texto nao foi mudado para nao alterar o SHA256 conferido nas demais.#(lf)#(lf)Somente leitura. Batch unico. Nao existe GO neste arquivo.#(lf)================================================================================#(lf)*/#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- [0] PARAMETROS#(lf)--#(lf)-- Datas em horario do Brasil. Intervalo SEMIABERTO: >= inicio e < fim.#(lf)-- Nao usar 23:59:59 como fim: o chamado do ultimo segundo do dia ficaria de fora.#(lf)--#(lf)-- open_date e close_date em dbo.call_req sao epoch UTC em segundos (int).#(lf)-- Brasil = UTC-3 fixo (sem horario de verao desde 2019).#(lf)--------------------------------------------------------------------------------#(lf)DECLARE @HorasBrasilParaUTC int = 3;#(lf)DECLARE @Epoch datetime2(0) = '1970-01-01 00:00:00';#(lf)#(lf)-- [POWER BI] Periodo automatico, calculado no inicio do arquivo.#(lf)DECLARE @InicioBR datetime2(0) = @PBI_InicioBR;   -- inclusivo#(lf)DECLARE @FimBR    datetime2(0) = @PBI_FimBR;      -- EXCLUSIVO#(lf)#(lf)DECLARE @InicioEpoch int = DATEDIFF(SECOND, @Epoch, DATEADD(HOUR, @HorasBrasilParaUTC, @InicioBR));#(lf)DECLARE @FimEpoch    int = DATEDIFF(SECOND, @Epoch, DATEADD(HOUR, @HorasBrasilParaUTC, @FimBR));#(lf)#(lf)-- Identidade do COI por UUID. Usada no filtro de ENCERRADOS e na classificacao#(lf)-- 'Membro do grupo COI'. A regra de Registrados NAO usa UUID: decide por nome#(lf)-- historico.#(lf)DECLARE @COI_Antigo varbinary(16) = 0xDA7095D797E3FE498A62B79CB7EAED15;  -- 'Contrato 7/2023 - COI'#(lf)DECLARE @COI_Novo   varbinary(16) = 0x3C11B3A9EBCE5D498E2F7D7FF385F967;  -- 'COI'#(lf)#(lf)-- Grupo alvo de ENCERRADOS. UM grupo por apuracao: producao/contrato vigente ->#(lf)-- @COI_Novo. NAO somar os dois, NAO inferir pela data (os grupos coexistiram).#(lf)-- Ver o cabecalho de consulta_coi_encerrados.sql.#(lf)DECLARE @COI_GrupoAlvo varbinary(16) = @COI_Novo;#(lf)#(lf)-- 0 = apenas o resultado por membro (uso normal).#(lf)-- 1 = acrescenta um result set com a atribuicao de cada encerramento.#(lf)DECLARE @MostrarDiagnostico bit = 0;#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- INICIO REGRA CANONICA DE REGISTRADOS COI#(lf)--#(lf)-- Bloco IDENTICO, byte a byte, nas SETE consultas de Registrados:#(lf)--     INDICADORES#(lf)--       consulta_coi_registrados_mensal.sql#(lf)--       consulta_coi_registrados_encerrados_diario.sql#(lf)--       consulta_coi_registrados_por_hora.sql#(lf)--     AUDITORIA#(lf)--       consulta_coi_registrados_detalhe.sql#(lf)--       consulta_coi_registrados_por_registrador.sql#(lf)--       consulta_coi_registrados_por_evidencia.sql#(lf)--       consulta_coi_registrados_validacao.sql#(lf)--#(lf)-- Conferir com SHA256 do trecho entre os marcadores. Nao basta parecerem iguais.#(lf)--#(lf)-- A REGRA#(lf)--#(lf)--   Um SDM e Registrado pelo COI quando ENTRA NO COI PELA PRIMEIRA VEZ NA VIDA#(lf)--   do chamado. Cada SDM produz UMA data:#(lf)--#(lf)--       DataRegistroCOI#(lf)--#(lf)--   e os indicadores mensal, diario e por hora sao agrupados por ela - NAO por#(lf)--   call_req.open_date. Um SDM conta UMA vez. Reentrada nao gera novo registro.#(lf)--#(lf)-- O QUE MUDOU: O INIT DEIXOU DE SER A EVIDENCIA PRINCIPAL#(lf)--#(lf)--   A versao anterior consultava primeiro o '%GROUP=' do evento INIT e, se ele#(lf)--   fosse alias do COI, fixava DataRegistroCOI = open_date sem olhar a cadeia.#(lf)--   Isso foi REFUTADO por dados: existem chamados cujo INIT declara '10-COI' e#(lf)--   cuja primeira mudanca real de grupo prova que eles estavam em OUTRA fila.#(lf)--#(lf)--       1686505  INIT='10-COI'  aberto 18/03 22:08:45#(lf)--                1o evento: GESTAO DE SUPORTE REMOTO -> COI  em 22:09:37#(lf)--#(lf)--   O chamado nao foi aberto no COI as 22:08:45. Ele ENTROU no COI as 22:09:37.#(lf)--   O INIT carrega o grupo PEDIDO no template da automacao, que pode nao ser o#(lf)--   grupo em que o chamado efetivamente nasceu.#(lf)--#(lf)--   Por isso a hierarquia se inverteu. O INIT continua no resultado, como#(lf)--   evidencia AUXILIAR e auditavel (colunas GrupoInit e#(lf)--   InitConsistenteComReconstrucao), mas NAO decide mais a data.#(lf)--#(lf)-- HIERARQUIA DE EVIDENCIA - determinista, uma evidencia por SDM#(lf)--   (AUTOMACAO_TASK_SCHEDULER entra como ULTIMO ramo; ver PRECEDENCIA)#(lf)--#(lf)--   1. CADEIA REAL DE MUDANCAS DE GRUPO - evidencia principal#(lf)--#(lf)--      ABERTO_NO_COI_CADEIA#(lf)--          a ORIGEM do primeiro evento real de grupo pertence ao universo#(lf)--          logico COI -> DataRegistroCOI = open_date#(lf)--          Nao havendo mudanca de grupo anterior, o chamado ja estava no COI#(lf)--          antes da primeira transferencia observada.#(lf)--#(lf)--      TRANSFERIDO_PARA_COI#(lf)--          a origem do primeiro evento e legivel e NAO e COI: o chamado nasceu#(lf)--          fora -> DataRegistroCOI = primeiro evento cujo DESTINO e COI#(lf)--#(lf)--      JA_ESTAVA_NO_COI_HISTORICO#(lf)--          a origem do primeiro evento e 'CONTRATO 7/2023 - COI', o chamado foi#(lf)--          aberto ANTES da transicao, o %GROUP= do INIT nao aponta fila nao-COI#(lf)--          e nao ha ancora de grupo ilegivel antes do primeiro evento legivel#(lf)--          -> DataRegistroCOI = open_date#(lf)--#(lf)--          Esse nome e o rotulo POSTERIOR da fila que, antes da transicao, se#(lf)--          chamava 'COI'. O act_log grava o nome vigente NO INSTANTE DO EVENTO,#(lf)--          entao um chamado de 2023 que so se move em 2026 tem o evento gravado#(lf)--          com o nome novo da fila velha. Ler isso como \"\"entrou no COI agora\"\"#(lf)--          apaga a entrada historica e joga o SDM para outro mes.#(lf)--#(lf)--          Caso 1419597: aberto em 2023-05-29, primeiro evento em jun/2026 com#(lf)--          origem 'CONTRATO 7/2023 - COI' e destino 'COI'. A primeira entrada e#(lf)--          2023, nao junho de 2026.#(lf)--#(lf)--          AS DUAS TRAVAS, e por que existem. A origem so prova que o SDM estava#(lf)--          naquela fila IMEDIATAMENTE ANTES da transferencia - nao que estava la#(lf)--          desde a abertura. Entre a abertura e o primeiro evento observavel#(lf)--          pode ter havido movimentacao que o log nao mostra. Entao:#(lf)--#(lf)--            1. se o %GROUP= do INIT nomeia uma fila NAO-COI, ele e evidencia#(lf)--               direta e contemporanea de que o chamado nasceu fora. Datar em#(lf)--               open_date afirmaria um nascimento que o proprio registro de#(lf)--               abertura nega -> CONTRADICAO_INIT_x_CADEIA, ressalva.#(lf)--#(lf)--               A compatibilidade aqui e TEMPORAL, nao apenas nominal. Para#(lf)--               abertura anterior a transicao, so 'COI' e '10-COI' sao INIT#(lf)--               compativeis - e '10-COI' entra porque tem evento operacional#(lf)--               real desde 13/02/2026. 'CONTRATO 7/2023 - COI' NAO e: esse nome#(lf)--               so passa a existir NA transicao, e o INIT e escrito na criacao.#(lf)--               Encontra-lo num chamado aberto antes e anomalia a auditar, nao#(lf)--               evidencia de pertencimento#(lf)--               -> INIT_CONTRATO_INCOMPATIVEL_COM_DATA_ABERTURA, ressalva.#(lf)--#(lf)--               Note que #AliasInit NAO serve de trava aqui, embora sirva a#(lf)--               auditoria geral do rotulo: ela inclui o nome do contrato, e#(lf)--               usa-la deixaria passar exatamente o caso anomalo.#(lf)--            2. se existe ancora de grupo ILEGIVEL antes do primeiro evento#(lf)--               legivel, esse evento pode nao ser o primeiro da vida, e a#(lf)--               origem dele nao descreve a abertura#(lf)--               -> SEM_RECONSTRUCAO_EVENTO_ILEGIVEL, ressalva.#(lf)--#(lf)--          Isto NAO devolve o INIT ao topo da hierarquia. Ele nao escolhe data#(lf)--          em ramo nenhum; aqui ele so IMPEDE uma inferencia que o contradiz.#(lf)--#(lf)--      ENTRADA_DEMONSTRAVEL_DESTINO#(lf)--          a origem do primeiro evento nao prova a primeira entrada, mas existe#(lf)--          evento com DESTINO COI -> DataRegistroCOI = esse evento#(lf)--#(lf)--          A origem pode falhar de duas maneiras, e as duas caem aqui:#(lf)--            ilegivel no TEXTO      \"\"'' -> COI\"\" (caso 1686579)#(lf)--            ilegivel no SIGNIFICADO origem 'CONTRATO 7/2023 - COI' em chamado#(lf)--                                    aberto DENTRO da janela de renomeacao, em#(lf)--                                    que nao se sabe sob que nome aquele UUID#(lf)--                                    operava#(lf)--#(lf)--          Nos dois casos a ENTRADA e demonstravel naquele instante, e so a#(lf)--          antecipacao para open_date e que fica impedida - antecipar seria#(lf)--          afirmar um nascimento que o log nao mostra.#(lf)--#(lf)--   2. FALLBACK DE ESTADO - autorizado pelo gerente, SO sem cadeia utilizavel#(lf)--#(lf)--      ABERTO_NO_COI_INFERIDO_GRUPO_ATUAL#(lf)--          nenhum evento de grupo em toda a vida, e group_id atual = COI novo#(lf)--          -> DataRegistroCOI = open_date#(lf)--          \"\"sem log de mudanca, considerar a fila em que o chamado permaneceu\"\"#(lf)--#(lf)--      ABERTO_NO_COI_INFERIDO_GRUPO_ATUAL_HISTORICO#(lf)--          nenhum evento de grupo, group_id atual = COI antigo, e o chamado foi#(lf)--          aberto ANTES da transicao -> DataRegistroCOI = open_date#(lf)--          Reconstrucao historica: quando ele nasceu, aquele UUID se chamava#(lf)--          'COI' e era a fila do COI.#(lf)--#(lf)--   3. FORA DO INDICADOR, mas VISIVEL em #RegRessalvas#(lf)--#(lf)--      SEM_RECONSTRUCAO_EVENTO_ILEGIVEL#(lf)--          existe evento com ancora de grupo, mas NENHUM legivel. Nao se pode#(lf)--          reconstruir a cadeia - e nao se pode cair no fallback, porque houve#(lf)--          movimentacao. Contar aqui seria afirmar permanencia onde houve#(lf)--          movimento que nao sabemos ler.#(lf)--#(lf)--      CONTRADICAO_INIT_x_CADEIA#(lf)--          a origem historica sugere pertencimento ao COI, mas o %GROUP= do#(lf)--          INIT nomeia explicitamente uma fila nao-COI. As duas evidencias se#(lf)--          contradizem e a entrada correta nao e demonstravel. Vai para#(lf)--          auditoria em vez de receber open_date inventado.#(lf)--#(lf)--      INIT_CONTRATO_INCOMPATIVEL_COM_DATA_ABERTURA#(lf)--          o chamado abriu ANTES da transicao mas o %GROUP= do INIT ja traz#(lf)--          'CONTRATO 7/2023 - COI', nome que a fila so recebeu DEPOIS. O#(lf)--          registro de abertura nao pode conhecer um nome futuro: ou a linha#(lf)--          INIT nao descreve a criacao, ou a data de abertura nao e a que#(lf)--          parece. Qualquer das duas invalida a inferencia historica.#(lf)--#(lf)--      AMBIGUO_JANELA_TRANSICAO#(lf)--          abertura DENTRO da janela de renomeacao E nenhuma entrada#(lf)--          demonstravel em fila COI. Duas formas:#(lf)--            sem cadeia, group_id atual = COI antigo - o UUID antigo sozinho#(lf)--              nao data a abertura ali;#(lf)--            com cadeia cuja origem e 'CONTRATO 7/2023 - COI' mas sem nenhum#(lf)--              evento com destino COI.#(lf)--#(lf)--          A ressalva EXIGE ausencia de entrada demonstravel. Ela existe para o#(lf)--          caso \"\"nao sei SE entrou\"\", nao para \"\"nao sei QUANDO entrou\"\". Havendo#(lf)--          evento com destino em fila COI, o SDM entra pelo ramo#(lf)--          ENTRADA_DEMONSTRAVEL_DESTINO, datado nesse evento.#(lf)--#(lf)--      NAO_ENTRA#(lf)--          cadeia existe e nunca toca o COI, ou estado atual nao e COI.#(lf)--          Descartado antes de #RegBase.#(lf)--#(lf)--   A ordem importa: a cadeia real e consultada PRIMEIRO e vence sempre. O#(lf)--   fallback so e alcancado quando nao existe NENHUM evento de grupo.#(lf)--#(lf)-- UNIVERSO LOGICO COI NOS EVENTOS REAIS#(lf)--#(lf)--   Aceitos:      COI      e  10-COI#(lf)--   NAO aceito:   CONTRATO 7/2023 - COI#(lf)--#(lf)--   '10-COI' entra porque a serie temporal provou que sua atuacao operacional#(lf)--   real ficou restrita ao periodo de transicao:#(lf)--#(lf)--       como destino: 2026-02-13 16:45:06  ate  2026-03-18 19:29:11#(lf)--       como origem : 2026-02-27 16:40:06  ate  2026-03-18 20:35:51#(lf)--#(lf)--   Nenhum evento real com '10-COI' depois disso. Ele foi, temporariamente, o#(lf)--   nome da fila do COI - e nesse intervalo transferir para '10-COI' era#(lf)--   transferir para o COI.#(lf)--#(lf)--   'CONTRATO 7/2023 - COI' e ASSIMETRICO, e essa e a correcao mais importante#(lf)--   desta regra. Ele vale conforme a POSICAO que ocupa no evento:#(lf)--#(lf)--     como DESTINO, depois da transicao        NAO cria entrada#(lf)--         'OUTRA FILA' -> 'CONTRATO 7/2023 - COI' e movimentacao para a fila do#(lf)--         contrato ENCERRADO. Nao e entrada no COI corrente. Por isso o nome#(lf)--         NAO esta em #AliasCOI, que so decide destino.#(lf)--#(lf)--     como ORIGEM, em chamado aberto ANTES da transicao   PROVA pertencimento#(lf)--         'CONTRATO 7/2023 - COI' -> 'COI' diz que, imediatamente antes dessa#(lf)--         transferencia, o SDM ja estava na fila que naquela epoca se chamava#(lf)--         'COI'. Ele ja era do universo logico COI. A primeira entrada e a#(lf)--         abertura, nao essa transferencia.#(lf)--#(lf)--   A assimetria existe porque um evento POSTERIOR a renomeacao registra a#(lf)--   origem pelo nome vigente NAQUELE momento. Logo, o primeiro evento historico#(lf)--   disponivel pode mostrar o nome NOVO de uma fila na qual o chamado ja estava#(lf)--   ANTES da renomeacao.#(lf)--#(lf)--   Nenhuma linha antiga do act_log e alterada: as linhas gravadas antes da#(lf)--   troca continuam com o nome antigo. O que muda e o nome usado pelas linhas#(lf)--   gravadas DEPOIS. Ler origem e destino com o mesmo criterio confunde as duas#(lf)--   coisas.#(lf)--#(lf)--   RESTRICAO: a leitura da origem exige abertura ANTES da transicao. Um chamado#(lf)--   aberto DEPOIS dela cujo primeiro evento parte de 'CONTRATO 7/2023 - COI'#(lf)--   nasceu mesmo na fila do contrato encerrado - ali o nome nao e rotulo#(lf)--   retroativo, e a fila de verdade. Esse cai nos ramos normais de entrada por#(lf)--   destino. Aberto DENTRO da janela: ressalva.#(lf)--#(lf)--   O nome 'COI' vale nos DOIS lados da troca. Ele mudou de UUID, mas nao de#(lf)--   significado de negocio: dos dois lados ele designa a fila do COI. Como o#(lf)--   indicador mede primeira entrada no universo logico COI, e nao pertencimento#(lf)--   a um UUID, a troca de identidade do nome nao altera o indicador.#(lf)--#(lf)-- JANELA DE TRANSICAO#(lf)--#(lf)--       (2026-03-18 20:35:51 , 2026-03-18 21:48:58]#(lf)--#(lf)--   Extremos medidos: ultima aparicao operacional de '10-COI' e primeira de#(lf)--   'CONTRATO 7/2023 - COI'. Como max(10-COI) < min(CONTRATO), nao ha#(lf)--   intercalamento entre os dois nomes.#(lf)--#(lf)--   A janela impede INFERENCIA, nunca apaga EVIDENCIA. Dentro dela nao se sabe#(lf)--   sob que nome o UUID antigo operava, entao nao se pode inferir pertencimento#(lf)--   a partir da origem nem do estado atual - mas um evento com destino em fila#(lf)--   COI continua provando a entrada, e com instante conhecido.#(lf)--#(lf)--   Por isso ela so exclui quando NAO ha entrada demonstravel. Confundir as#(lf)--   duas coisas faria a regra responder \"\"nao sei se entrou\"\" quando o log diz#(lf)--   \"\"entrou as 21:48:58, so nao sei se ja estava antes\"\".#(lf)--#(lf)-- REENTRADAS - uma contagem por SDM#(lf)--#(lf)--   DataRegistroCOI e a PRIMEIRA entrada da vida. A busca varre a vida inteira#(lf)--   do chamado, sem recorte de janela; so depois a janela filtra. Se o SDM#(lf)--   entrou no COI em janeiro, saiu e voltou em fevereiro, ele e de janeiro e#(lf)--   nao reaparece em fevereiro.#(lf)--#(lf)--   Movimentos COI -> 10-COI e 10-COI -> COI sao movimentacao INTERNA do#(lf)--   universo logico e nao geram entrada nova: ambos os nomes estao em#(lf)--   #AliasCOI, entao a origem do primeiro evento ja e COI e o SDM fica com#(lf)--   open_date pelo ramo ABERTO_NO_COI_CADEIA.#(lf)--#(lf)-- CANDIDATOS - por EVENTO, nunca por idade do chamado#(lf)--#(lf)--   Para uma DataRegistroCOI cair dentro da janela, so existem dois caminhos:#(lf)--#(lf)--     A) o chamado ABRIU dentro da janela (nasceu no COI, entrou nela, ou caiu#(lf)--        no fallback de estado - todos dao DataRegistroCOI = open_date);#(lf)--     B) houve ENTRADA no COI dentro da janela, qualquer que seja a idade.#(lf)--#(lf)--   Entao o universo e A UNIAO B. Um chamado aberto ha dois anos em outro#(lf)--   nucleo, transferido ao COI ontem, entra por B - sem horizonte de abertura.#(lf)--#(lf)--   Isto NAO e otimizacao: e a diferenca entre \"\"primeira entrada da vida\"\" e#(lf)--   \"\"primeira entrada entre os chamados que resolvemos carregar\"\". Um recorte#(lf)--   por open_date nao pode ser validado por contador nenhum, porque o que ele#(lf)--   exclui fica de fora ANTES de existir para ser contado.#(lf)--#(lf)-- IDENTIDADE HISTORICA - por texto, nunca por UUID atual#(lf)--#(lf)--   O act_log grava o grupo por NOME textual historico. Resolver esse nome#(lf)--   contra o cadastro ATUAL reescreve o passado com o presente. Por isso os#(lf)--   eventos sao decididos por tabela EXPLICITA de aliases, e nao por JOIN em#(lf)--   ca_contact nem por LIKE '%COI%'. O UUID so aparece no fallback, que e#(lf)--   justamente o ramo em que nao ha texto historico para ler.#(lf)--#(lf)-- CONTAS TECNICAS: ONDE ENTRAM E ONDE NAO ENTRAM#(lf)--#(lf)--   ServiceDesk, usr_automacoes e sesuc_auto sao compartilhadas com outros#(lf)--   nucleos. Um NOME DE CONTA, sozinho, continua nao provando pertencimento ao#(lf)--   COI, e continua nao existindo ramo que conte um chamado so porque ele foi#(lf)--   aberto por conta tecnica.#(lf)--#(lf)--   O que mudou: a modalidade Task Scheduler / SESUC, informada oficialmente#(lf)--   pela gestao, e definida por uma TRINCA - interface CMD, %FROM_USERID=#(lf)--   servicedesk e %GROUP= dentro de uma lista fechada de filas. A conta e#(lf)--   apenas UM dos tres termos, e nenhum dos tres basta sozinho.#(lf)--#(lf)--   Para Zabbix, log_agent = usr_automacoes participa APENAS da coluna#(lf)--   informativa TipoAutomacaoCOI. Nao decide pertencimento nem data: os#(lf)--   chamados do Zabbix ja entram pela cadeia real, porque nascem no COI.#(lf)--#(lf)-- AUTOMACOES OFICIAIS - tres modalidades informadas pela gestao#(lf)--#(lf)--   A regra deixou de depender EXCLUSIVAMENTE de passagem pela fila COI. O#(lf)--   motivo e factual: o Task Scheduler registra direto na fila do NSTI ou do#(lf)--   fornecedor, e esses chamados nunca produzem evento de grupo com origem ou#(lf)--   destino no COI. Antes, eles nao existiam para o indicador.#(lf)--#(lf)--   1. TASK SCHEDULER / SESUC     -> DECIDE pertencimento#(lf)--#(lf)--      Criterio oficial, os tres termos ao mesmo tempo:#(lf)--          primeiro log 'Criado via interface CMD'#(lf)--          %FROM_USERID= servicedesk#(lf)--          %GROUP= em #GrupoTaskSched (lista oficial fechada, [R1c])#(lf)--#(lf)--      Evidencia propria: AUTOMACAO_TASK_SCHEDULER, com#(lf)--      DataRegistroCOI = open_date. O rotulo NAO afirma entrada na fila COI -#(lf)--      afirma registro por automacao oficial do COI em fila de destino. Por#(lf)--      isso e rotulo separado, e nao reuso de ABERTO_NO_COI_*.#(lf)--#(lf)--   2. ZABBIX MONITOR             -> so CLASSIFICA#(lf)--#(lf)--      log_agent = usr_automacoes e type = 'I'. Os exemplos oficiais ja entram#(lf)--      pela cadeia (ABERTO_NO_COI_CADEIA): o Zabbix abre no COI e o COI#(lf)--      transfere adiante. Nada aqui cria linha nova nem altera data.#(lf)--#(lf)--      O campo 'Relatado por' da tela corresponde a log_agent.#(lf)--      call_req.customer varia entre contas de infraestrutura e NAO e criterio.#(lf)--#(lf)--   3. ROBO COI / COPILOT STUDIO  -> so CLASSIFICA#(lf)--#(lf)--      Os exemplos oficiais ja entram pela cadeia ou pelo grupo atual. A#(lf)--      assinatura usada aqui e EVIDENCIA TECNICA OBSERVADA, e nao criterio de#(lf)--      negocio declarado pela gestao: interface CMD, DUAS ocorrencias de#(lf)--      %FROM_USERID= e presenca de %TYPE=, quase sempre com %GROUP=COI.#(lf)--#(lf)--      %FROM_USERID= gravado NAO e vazio: contem a matricula do solicitante,#(lf)--      ou uma conta tecnica. O modelo em branco mostrado pela gestao e marcador#(lf)--      de template, nao o valor armazenado.#(lf)--#(lf)--      Por ser correlacao observada, ela alimenta SOMENTE a coluna informativa#(lf)--      TipoAutomacaoCOI. Nenhum chamado entra, sai ou muda de data por causa#(lf)--      dela.#(lf)--#(lf)--   TipoAutomacaoCOI explica a ORIGEM do registro. EvidenciaRegistroCOI explica#(lf)--   POR QUE e QUANDO o chamado entrou no indicador. Sao independentes.#(lf)--#(lf)-- PRECEDENCIA ENTRE CADEIA, AUTOMACAO, FALLBACK E HISTORICO#(lf)--#(lf)--   1. cadeia real de eventos de grupo    ABERTO_NO_COI_CADEIA,#(lf)--                                         JA_ESTAVA_NO_COI_HISTORICO,#(lf)--                                         TRANSFERIDO_PARA_COI,#(lf)--                                         ENTRADA_DEMONSTRAVEL_DESTINO#(lf)--   2. travas e ressalvas de historico e da janela de transicao#(lf)--   3. fallback de estado por grupo atual ABERTO_NO_COI_INFERIDO_GRUPO_ATUAL,#(lf)--                                         ABERTO_NO_COI_INFERIDO_GRUPO_ATUAL_HISTORICO#(lf)--   4. automacao Task Scheduler           AUTOMACAO_TASK_SCHEDULER#(lf)--#(lf)--   A automacao e o ULTIMO recurso, deliberadamente. Assim nenhum chamado que#(lf)--   ja contava por cadeia, historico ou grupo atual muda de evidencia ou de#(lf)--   data: os ramos anteriores disparam primeiro. A automacao so alcanca quem#(lf)--   antes terminava em NAO_ENTRA.#(lf)--#(lf)--   Consequencia aceita: se a cadeia esta ilegivel (ancora de grupo sem nenhum#(lf)--   evento legivel), o chamado permanece na ressalva#(lf)--   SEM_RECONSTRUCAO_EVENTO_ILEGIVEL mesmo sendo elegivel por automacao.#(lf)--   Preferiu-se nao deixar a automacao apagar uma ressalva existente. Quantos#(lf)--   casos sao, a consulta de validacao mede - nao se supoe.#(lf)--------------------------------------------------------------------------------#(lf)#(lf)-- [R0] Identidade da fila COI e janela de transicao.#(lf)--      Nomes proprios (@COI_UUID_*) para nao colidir com @COI_Antigo/@COI_Novo#(lf)--      que alguns arquivos ja declaram para o lado de Encerrados.#(lf)DECLARE @COI_UUID_Antigo varbinary(16) = 0xDA7095D797E3FE498A62B79CB7EAED15;  -- hoje 'CONTRATO 7/2023 - COI'#(lf)DECLARE @COI_UUID_Novo   varbinary(16) = 0x3C11B3A9EBCE5D498E2F7D7FF385F967;  -- hoje 'COI'#(lf)#(lf)DECLARE @TransIniBR datetime2(0) = '2026-03-18 20:35:51';  -- ultimo evento real '10-COI'#(lf)DECLARE @TransFimBR datetime2(0) = '2026-03-18 21:48:58';  -- 1o evento real 'CONTRATO 7/2023 - COI'#(lf)-- Conta tecnica do Zabbix, resolvida por userid e nunca por UUID fixo. Serve#(lf)-- exclusivamente a coluna informativa TipoAutomacaoCOI. Se a conta nao existir,#(lf)-- fica NULL e a classificacao apenas nao marca Zabbix - nenhum chamado entra#(lf)-- ou sai por causa disso.#(lf)DECLARE @UUID_UsrAutomacoes varbinary(16) = (#(lf)    SELECT TOP (1) k.contact_uuid FROM dbo.ca_contact AS k#(lf)    WHERE k.userid COLLATE Latin1_General_CI_AI = N'usr_automacoes');#(lf)#(lf)DECLARE @TransIniEpoch int = DATEDIFF(SECOND, @Epoch, DATEADD(HOUR, @HorasBrasilParaUTC, @TransIniBR));#(lf)DECLARE @TransFimEpoch int = DATEDIFF(SECOND, @Epoch, DATEADD(HOUR, @HorasBrasilParaUTC, @TransFimBR));#(lf)#(lf)-- [R1] Universo logico COI nos EVENTOS REAIS de grupo. Tabela explicita.#(lf)--      'CONTRATO 7/2023 - COI' NAO esta aqui: ver o bloco de documentacao.#(lf)IF OBJECT_ID('tempdb..#AliasCOI') IS NOT NULL DROP TABLE #AliasCOI;#(lf)CREATE TABLE #AliasCOI (nome_norm nvarchar(200) COLLATE DATABASE_DEFAULT NOT NULL PRIMARY KEY);#(lf)INSERT INTO #AliasCOI (nome_norm) VALUES (N'COI'), (N'10-COI');#(lf)#(lf)-- [R1b] Nomes considerados COI APENAS para auditar o %GROUP= do INIT. Inclui o#(lf)--       nome do contrato antigo porque aqui o objetivo e medir consistencia do#(lf)--       rotulo, nao decidir pertencimento. Esta tabela NAO entra em nenhuma#(lf)--       decisao de DataRegistroCOI.#(lf)IF OBJECT_ID('tempdb..#AliasInit') IS NOT NULL DROP TABLE #AliasInit;#(lf)CREATE TABLE #AliasInit (nome_norm nvarchar(200) COLLATE DATABASE_DEFAULT NOT NULL PRIMARY KEY);#(lf)INSERT INTO #AliasInit (nome_norm) VALUES (N'COI'), (N'10-COI'), (N'CONTRATO 7/2023 - COI');#(lf)#(lf)-- [R1c] Filas oficiais do Task Scheduler / SESUC, exatamente como a gestao#(lf)--       informou. A lista e FECHADA: %GROUP= fora dela NAO entra pela#(lf)--       automacao, ainda que o chamado seja 'Criado via interface CMD' por#(lf)--       servicedesk.#(lf)--#(lf)--       Os nomes estao SEM ACENTO de proposito. Todo o bloco e ASCII e a#(lf)--       comparacao usa Latin1_General_CI_AI, accent-insensitive: 'NSTI#(lf)--       SEGURANCA' casa com o nome gravado com cedilha e 'NSTI APLICACAO' casa#(lf)--       com o gravado com til. Os valores tambem chegam em caixa alta, porque#(lf)--       #RegInitTag ja aplica UPPER.#(lf)--#(lf)--       '10-COI' e o nome historico do COI e NAO esta na lista oficial. Isso e#(lf)--       proposital: chamados assim entram - quando entram - pela cadeia real,#(lf)--       e nao pela automacao.#(lf)IF OBJECT_ID('tempdb..#GrupoTaskSched') IS NOT NULL DROP TABLE #GrupoTaskSched;#(lf)CREATE TABLE #GrupoTaskSched (nome_norm nvarchar(200) COLLATE DATABASE_DEFAULT NOT NULL PRIMARY KEY);#(lf)INSERT INTO #GrupoTaskSched (nome_norm) VALUES#(lf)    (N'FORNECEDORES - A2B'),#(lf)    (N'FORNECEDORES - AMM'),#(lf)    (N'FORNECEDORES - BULL'),#(lf)    (N'FORNECEDORES BULL - 41/2022 - G1 - FA1/FA2'),#(lf)    (N'FORNECEDORES BULL - 41/2022 - G2 - FB1'),#(lf)    (N'FORNECEDORES BULL - 45/2020 - G1 - FA3/FA4/FA5'),#(lf)    (N'FORNECEDORES BULL - 45/2020 - G2 - FB2'),#(lf)    (N'FORNECEDORES BULL - 45/2020 - G3 - FA-NAS-1 / FB3'),#(lf)    (N'FORNECEDORES - DECISION'),#(lf)    (N'NSTI REDE'),#(lf)    (N'NSTI SEGURANCA'),#(lf)    (N'NSTI APLICACAO'),#(lf)    (N'NSTI AD-WORKPLACE'),#(lf)    (N'NSTI BD'),#(lf)    (N'NSTI BI-ANALYTICS'),#(lf)    (N'NSTI SO'),#(lf)    (N'NSTI GCM'),#(lf)    (N'NSTI PLAN-DOC'),#(lf)    (N'COI');#(lf)#(lf)-- [R2a] CONJUNTO A - chamados I/R abertos DENTRO da janela.#(lf)--       open_date e type crus: sargaveis.#(lf)IF OBJECT_ID('tempdb..#CandA') IS NOT NULL DROP TABLE #CandA;#(lf)#(lf)SELECT r.id, r.persid#(lf)INTO #CandA#(lf)FROM dbo.call_req AS r#(lf)WHERE r.[type] IN ('I', 'R')#(lf)  AND r.open_date >= @InicioEpoch#(lf)  AND r.open_date <  @FimEpoch#(lf)OPTION (RECOMPILE);#(lf)#(lf)CREATE UNIQUE CLUSTERED INDEX IX_CandA ON #CandA(id);#(lf)#(lf)-- [R2b] CONJUNTO B - chamados que RECEBERAM entrada no COI dentro da janela,#(lf)--       com QUALQUER idade de abertura.#(lf)--#(lf)--       Aqui o act_log e filtrado por system_time, e nao por call_req_id. Se#(lf)--       nao houver indice temporal em act_log, este passo e uma varredura da#(lf)--       tabela, e o custo esta assumido. A alternativa seria recortar por data#(lf)--       de abertura - e era exatamente isso que tornava a regra falsa.#(lf)--#(lf)--       O LIKE '%COI%' e PRE-FILTRO, nao criterio: 'COI' e '10-COI' contem essa#(lf)--       substring, entao ele nao pode perder linha. Serve so para nao levar a#(lf)--       tempdb o texto de toda transferencia da janela. Quem decide e a ancora#(lf)--       de grupo e o par de aspas, logo abaixo.#(lf)IF OBJECT_ID('tempdb..#EvJanela') IS NOT NULL DROP TABLE #EvJanela;#(lf)#(lf)SELECT#(lf)    al.call_req_id,#(lf)    (CONVERT(nvarchar(max), ISNULL(al.description, N'')) + N' ' +#(lf)     CONVERT(nvarchar(max), ISNULL(al.action_desc,  N'')))#(lf)        COLLATE Latin1_General_CI_AI AS texto#(lf)INTO #EvJanela#(lf)FROM dbo.act_log AS al#(lf)WHERE al.[type] = 'TR'#(lf)  AND al.system_time >= @InicioEpoch#(lf)  AND al.system_time <  @FimEpoch#(lf)  AND (al.description COLLATE Latin1_General_CI_AI LIKE N'%COI%'#(lf)    OR al.action_desc COLLATE Latin1_General_CI_AI LIKE N'%COI%')#(lf)OPTION (RECOMPILE);#(lf)#(lf)CREATE CLUSTERED INDEX IX_EvJanela ON #EvJanela(call_req_id);#(lf)#(lf)-- Dos eventos da janela, so os que sao mesmo mudanca de GRUPO com destino COI.#(lf)-- \"\"Transferir Responsavel de 'A' para 'B'\"\" grava o mesmo tipo 'TR' e NAO casa#(lf)-- com nenhuma das cinco ancoras: troca de analista nao e troca de fila.#(lf)IF OBJECT_ID('tempdb..#CandB') IS NOT NULL DROP TABLE #CandB;#(lf)#(lf)SELECT DISTINCT r.id, r.persid#(lf)INTO #CandB#(lf)FROM #EvJanela AS a#(lf)JOIN dbo.call_req AS r#(lf)    ON a.call_req_id = r.persid#(lf)CROSS APPLY (SELECT p1 = CHARINDEX(N'Grupo de',             a.texto),#(lf)                    p2 = CHARINDEX(N'Grupo alterado de',    a.texto),#(lf)                    p3 = CHARINDEX(N'Grupo transferido de', a.texto),#(lf)                    p4 = CHARINDEX(N'Group from',           a.texto),#(lf)                    p5 = CHARINDEX(N'Group changed from',   a.texto)) AS pos#(lf)CROSS APPLY (SELECT posicao = CASE#(lf)        WHEN pos.p1 > 0 THEN pos.p1 + LEN(N'Grupo de')#(lf)        WHEN pos.p2 > 0 THEN pos.p2 + LEN(N'Grupo alterado de')#(lf)        WHEN pos.p3 > 0 THEN pos.p3 + LEN(N'Grupo transferido de')#(lf)        WHEN pos.p4 > 0 THEN pos.p4 + LEN(N'Group from')#(lf)        WHEN pos.p5 > 0 THEN pos.p5 + LEN(N'Group changed from')#(lf)        ELSE 0 END) AS anc#(lf)CROSS APPLY (SELECT resto = CONVERT(nvarchar(400),#(lf)                 SUBSTRING(a.texto, CASE WHEN anc.posicao > 0 THEN anc.posicao ELSE 1 END, 400))) AS g#(lf)CROSS APPLY (SELECT q1 = CHARINDEX(N'''', g.resto)) AS c1#(lf)CROSS APPLY (SELECT q2 = CASE WHEN c1.q1 > 0 THEN CHARINDEX(N'''', g.resto, c1.q1 + 1) ELSE 0 END) AS c2#(lf)CROSS APPLY (SELECT sp = CASE#(lf)        WHEN c2.q2 > 0 AND CHARINDEX(N' para ', g.resto, c2.q2) > 0 THEN CHARINDEX(N' para ', g.resto, c2.q2)#(lf)        WHEN c2.q2 > 0 THEN CHARINDEX(N' to ', g.resto, c2.q2)#(lf)        ELSE 0 END) AS sep#(lf)CROSS APPLY (SELECT q3 = CASE WHEN sep.sp > 0 THEN CHARINDEX(N'''', g.resto, sep.sp) ELSE 0 END) AS c3#(lf)CROSS APPLY (SELECT q4 = CASE WHEN c3.q3 > 0 THEN CHARINDEX(N'''', g.resto, c3.q3 + 1) ELSE 0 END) AS c4#(lf)CROSS APPLY (SELECT nome = CASE WHEN c4.q4 > c3.q3#(lf)                                THEN SUBSTRING(g.resto, c3.q3 + 1, c4.q4 - c3.q3 - 1) ELSE N'' END) AS des#(lf)CROSS APPLY (SELECT destino_norm = CONVERT(nvarchar(200), LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(#(lf)        UPPER(LTRIM(RTRIM(des.nome))), N' ', N'<>'), N'><', N''), N'<>', N' '))))) AS d#(lf)WHERE r.[type] IN ('I', 'R')#(lf)  AND anc.posicao > 0 AND c3.q3 > 0 AND c4.q4 > c3.q3#(lf)  AND EXISTS (SELECT 1 FROM #AliasCOI AS x#(lf)              WHERE x.nome_norm COLLATE Latin1_General_CI_AI#(lf)                  = d.destino_norm COLLATE Latin1_General_CI_AI);#(lf)#(lf)CREATE UNIQUE CLUSTERED INDEX IX_CandB ON #CandB(id);#(lf)#(lf)-- [R2] CANDIDATOS = A UNIAO B. Uma linha por SDM, sem recorte de idade.#(lf)IF OBJECT_ID('tempdb..#RegCand') IS NOT NULL DROP TABLE #RegCand;#(lf)#(lf)SELECT#(lf)    r.id, r.persid, r.ref_num, r.[type] AS tipo, r.group_id, r.open_date,#(lf)    -- log_agent viaja junto SO PARA AUDITORIA: e a coluna de \"\"quem abriu o#(lf)    -- chamado\"\". Ela NAO aparece em nenhum predicado nem na classificacao, e NAO#(lf)    -- e o ator que transferiu o chamado para o COI.#(lf)    r.log_agent,#(lf)    DATEADD(HOUR, -@HorasBrasilParaUTC, DATEADD(SECOND, r.open_date, @Epoch)) AS abertura_br#(lf)INTO #RegCand#(lf)FROM dbo.call_req AS r#(lf)WHERE EXISTS (SELECT 1 FROM #CandA AS a WHERE a.id = r.id)#(lf)   OR EXISTS (SELECT 1 FROM #CandB AS b WHERE b.id = r.id)#(lf)OPTION (RECOMPILE);#(lf)#(lf)CREATE UNIQUE CLUSTERED INDEX IX_RegCand_id ON #RegCand(id);#(lf)CREATE INDEX IX_RegCand_persid ON #RegCand(persid);#(lf)#(lf)-- [R3] VIDA INTEIRA dos candidatos em dbo.act_log. Traz 'TR' (movimentacao) e#(lf)--      'INIT' (criacao). O INIT hoje e auxiliar, mas continua sendo lido no#(lf)--      mesmo passe - separar as leituras custaria um segundo passe sobre a#(lf)--      tabela para produzir uma coluna de auditoria.#(lf)--#(lf)--      Esta e a SEGUNDA leitura de act_log do bloco, e ela e necessaria. A#(lf)--      primeira ([R2b]) foi por FAIXA DE TEMPO e serviu so para descobrir QUEM#(lf)--      sao os candidatos; esta e por call_req_id e traz a VIDA INTEIRA deles.#(lf)--#(lf)--      call_req_id fica CRU no ON - sem funcao, CAST ou COLLATE - preservando o#(lf)--      seek em act_log_x0. Qualquer coercao ali inutiliza o indice sobre uma#(lf)--      tabela de ~21 GB.#(lf)IF OBJECT_ID('tempdb..#RegAtos') IS NOT NULL DROP TABLE #RegAtos;#(lf)#(lf)SELECT#(lf)    c.id, al.system_time,#(lf)    CONVERT(varchar(30), al.[type]) COLLATE DATABASE_DEFAULT AS tipo_ato,#(lf)    (CONVERT(nvarchar(max), ISNULL(al.description, N'')) + N' ' +#(lf)     CONVERT(nvarchar(max), ISNULL(al.action_desc,  N'')))#(lf)        COLLATE Latin1_General_CI_AI AS texto#(lf)INTO #RegAtos#(lf)FROM #RegCand AS c#(lf)JOIN dbo.act_log AS al#(lf)    ON al.call_req_id = c.persid#(lf)   AND al.[type] IN ('TR', 'INIT')#(lf)   AND al.system_time IS NOT NULL#(lf)OPTION (RECOMPILE);#(lf)#(lf)CREATE CLUSTERED INDEX IX_RegAtos ON #RegAtos(id, system_time);#(lf)#(lf)-- [R4] AUXILIAR - %GROUP= do INIT.#(lf)--      Continua sendo extraido, mas nao decide mais DataRegistroCOI. Serve as#(lf)--      colunas GrupoInit e InitConsistenteComReconstrucao, que existem para#(lf)--      medir quanto o rotulo da abertura concorda com a cadeia reconstruida.#(lf)--#(lf)--      O valor comeca logo depois do '=' e termina no proximo '%'; sem outro#(lf)--      '%', vai ate o fim do texto. A busca e pelo literal '%GROUP=', entao#(lf)--      '%CATEGORY=COI...' nunca e lido como grupo e '%SUBGROUP=' tambem nao#(lf)--      casa. DATALENGTH/2 em vez de LEN porque LEN descarta espacos a direita e#(lf)--      erraria o comprimento no caso sem '%' final.#(lf)IF OBJECT_ID('tempdb..#RegInitTag') IS NOT NULL DROP TABLE #RegInitTag;#(lf)#(lf)SELECT#(lf)    a.id, a.system_time,#(lf)    CONVERT(nvarchar(200), LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(#(lf)        UPPER(REPLACE(REPLACE(REPLACE(v.bruto, CHAR(13), N' '), CHAR(10), N' '), CHAR(9), N' ')),#(lf)        N' ', N'<>'), N'><', N''), N'<>', N' '))))#(lf)        COLLATE DATABASE_DEFAULT AS grupo_init#(lf)INTO #RegInitTag#(lf)FROM #RegAtos AS a#(lf)CROSS APPLY (SELECT p = CHARINDEX(N'%GROUP=', a.texto)) AS t#(lf)CROSS APPLY (SELECT ini = t.p + 7) AS s#(lf)CROSS APPLY (SELECT fim = CASE WHEN t.p > 0 THEN CHARINDEX(N'%', a.texto, s.ini) ELSE 0 END) AS e#(lf)CROSS APPLY (SELECT tam = CASE WHEN t.p = 0 THEN 0#(lf)                               WHEN e.fim > s.ini THEN e.fim - s.ini#(lf)                               ELSE (DATALENGTH(a.texto) / 2) - s.ini + 1 END) AS n#(lf)CROSS APPLY (SELECT bruto = CASE WHEN n.tam > 0#(lf)                                 THEN LTRIM(RTRIM(SUBSTRING(a.texto, s.ini, n.tam)))#(lf)                                 ELSE N'' END) AS v#(lf)WHERE a.tipo_ato = 'INIT'#(lf)  AND t.p > 0 AND n.tam > 0 AND LEN(LTRIM(RTRIM(v.bruto))) > 0;#(lf)#(lf)CREATE CLUSTERED INDEX IX_RegInitTag ON #RegInitTag(id, system_time);#(lf)#(lf)-- [R4b] AUXILIAR - assinatura de automacao no evento INIT.#(lf)--#(lf)--       Le o MESMO texto de [R3] - description + action_desc concatenados, sem#(lf)--       truncamento - e produz quatro medidas por evento INIT:#(lf)--#(lf)--           via_cmd      o log comeca por 'Criado via interface CMD'#(lf)--           n_from       quantas vezes '%FROM_USERID=' aparece#(lf)--           n_type       quantas vezes '%TYPE=' aparece#(lf)--           from_userid  o VALOR de '%FROM_USERID=', normalizado#(lf)--#(lf)--       POR QUE O CORTE E DIFERENTE DO DE [R4]#(lf)--#(lf)--       [R4] corta o valor no proximo '%'. Isso funciona para %GROUP= porque#(lf)--       %AFFECTED_RC= sempre vem depois dele. Nao funciona para#(lf)--       %FROM_USERID=, que costuma ser a ULTIMA tag do INIT: sem um '%'#(lf)--       seguinte, o valor absorveria todo o texto restante e 'servicedesk'#(lf)--       viraria 'servicedesk Criar solicitacao/incidente/...'.#(lf)--#(lf)--       Por isso aqui o valor termina no PRIMEIRO de { '%', CR, LF }. Quando#(lf)--       nao ha nenhum dos tres, vai ate o fim do texto, e DATALENGTH/2 mede#(lf)--       esse fim - LEN descartaria espacos a direita e erraria o comprimento.#(lf)--#(lf)--       A normalizacao final e a mesma de [R4]: CHAR(13), CHAR(10) e CHAR(9)#(lf)--       viram espaco ANTES de qualquer comparacao, espacos repetidos colapsam#(lf)--       e o resultado vai para caixa alta. RTRIM sozinho nao removeria a quebra#(lf)--       de linha que o valor carrega.#(lf)--#(lf)--       n_from e n_type contam ocorrencias por diferenca de comprimento: o#(lf)--       texto sem a tag e mais curto exatamente (ocorrencias x tamanho da tag).#(lf)--       '%FROM_USERID=' tem 13 caracteres e '%TYPE=' tem 6.#(lf)IF OBJECT_ID('tempdb..#RegAutoTag') IS NOT NULL DROP TABLE #RegAutoTag;#(lf)#(lf)SELECT#(lf)    a.id, a.system_time,#(lf)    CONVERT(bit, CASE WHEN CHARINDEX(N'Criado via interface CMD', a.texto) > 0#(lf)                      THEN 1 ELSE 0 END) AS via_cmd,#(lf)    CONVERT(int, ((DATALENGTH(a.texto) / 2)#(lf)                  - (DATALENGTH(REPLACE(a.texto, N'%FROM_USERID=', N'')) / 2)) / 13) AS n_from,#(lf)    CONVERT(int, ((DATALENGTH(a.texto) / 2)#(lf)                  - (DATALENGTH(REPLACE(a.texto, N'%TYPE=', N'')) / 2)) / 6) AS n_type,#(lf)    CONVERT(nvarchar(200), LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(#(lf)        UPPER(REPLACE(REPLACE(REPLACE(v.bruto, CHAR(13), N' '), CHAR(10), N' '), CHAR(9), N' ')),#(lf)        N' ', N'<>'), N'><', N''), N'<>', N' '))))#(lf)        COLLATE DATABASE_DEFAULT AS from_userid#(lf)INTO #RegAutoTag#(lf)FROM #RegAtos AS a#(lf)CROSS APPLY (SELECT p = CHARINDEX(N'%FROM_USERID=', a.texto)) AS t#(lf)CROSS APPLY (SELECT ini = t.p + 13) AS s#(lf)CROSS APPLY (SELECT fim = CASE WHEN t.p = 0 THEN 0 ELSE z.menor END#(lf)             FROM (SELECT menor = MIN(w.p)#(lf)                   FROM (VALUES (NULLIF(CHARINDEX(N'%',     a.texto, t.p + 13), 0)),#(lf)                                (NULLIF(CHARINDEX(CHAR(13), a.texto, t.p + 13), 0)),#(lf)                                (NULLIF(CHARINDEX(CHAR(10), a.texto, t.p + 13), 0))#(lf)                        ) AS w(p)) AS z) AS e#(lf)CROSS APPLY (SELECT tam = CASE WHEN t.p = 0 THEN 0#(lf)                               WHEN e.fim > s.ini THEN e.fim - s.ini#(lf)                               ELSE (DATALENGTH(a.texto) / 2) - s.ini + 1 END) AS n#(lf)CROSS APPLY (SELECT bruto = CASE WHEN n.tam > 0#(lf)                                 THEN LTRIM(RTRIM(SUBSTRING(a.texto, s.ini, n.tam)))#(lf)                                 ELSE N'' END) AS v#(lf)WHERE a.tipo_ato = 'INIT';#(lf)#(lf)CREATE CLUSTERED INDEX IX_RegAutoTag ON #RegAutoTag(id, system_time);#(lf)#(lf)-- [R5] Ancora de GRUPO nos eventos 'TR'. Troca de grupo e troca de responsavel#(lf)--      gravam o MESMO tipo 'TR': sem a ancora, \"\"Transferir Responsavel de 'A'#(lf)--      para 'B'\"\" entraria como se fosse movimentacao de fila. Nenhuma das cinco#(lf)--      ancoras abaixo casa com esse texto, e e por isso que sao literais e nao#(lf)--      um padrao generico.#(lf)--#(lf)--      #RegRaw guarda TODA linha com ancora, inclusive as que o par de aspas#(lf)--      nao conseguir ler. Essa contagem e o que separa \"\"nao houve mudanca de#(lf)--      grupo\"\" de \"\"houve mudanca que nao sabemos ler\"\" - distincao que decide se#(lf)--      o fallback de estado pode ou nao ser aplicado.#(lf)IF OBJECT_ID('tempdb..#RegRaw') IS NOT NULL DROP TABLE #RegRaw;#(lf)#(lf)SELECT#(lf)    a.id, a.system_time,#(lf)    CONVERT(nvarchar(400), SUBSTRING(a.texto, anc.posicao, 400))#(lf)        COLLATE DATABASE_DEFAULT AS resto#(lf)INTO #RegRaw#(lf)FROM #RegAtos AS a#(lf)CROSS APPLY (SELECT p1 = CHARINDEX(N'Grupo de',             a.texto),#(lf)                    p2 = CHARINDEX(N'Grupo alterado de',    a.texto),#(lf)                    p3 = CHARINDEX(N'Grupo transferido de', a.texto),#(lf)                    p4 = CHARINDEX(N'Group from',           a.texto),#(lf)                    p5 = CHARINDEX(N'Group changed from',   a.texto)) AS pos#(lf)CROSS APPLY (SELECT posicao = CASE#(lf)        WHEN pos.p1 > 0 THEN pos.p1 + LEN(N'Grupo de')#(lf)        WHEN pos.p2 > 0 THEN pos.p2 + LEN(N'Grupo alterado de')#(lf)        WHEN pos.p3 > 0 THEN pos.p3 + LEN(N'Grupo transferido de')#(lf)        WHEN pos.p4 > 0 THEN pos.p4 + LEN(N'Group from')#(lf)        WHEN pos.p5 > 0 THEN pos.p5 + LEN(N'Group changed from')#(lf)        ELSE 0 END) AS anc#(lf)WHERE a.tipo_ato = 'TR'#(lf)  AND anc.posicao > 0;#(lf)#(lf)CREATE CLUSTERED INDEX IX_RegRaw ON #RegRaw(id, system_time);#(lf)#(lf)-- [R6] Origem e destino pelo par de aspas, com o nome normalizado ao lado.#(lf)--      Normalizacao LEVE de proposito: UPPER, trim e espacos colapsados, com a#(lf)--      PONTUACAO preservada. '10-COI' e 'CONTRATO 7/2023 - COI' se distinguem#(lf)--      justamente por ela. O acento e resolvido na comparacao, por collation.#(lf)--#(lf)--      ATENCAO: origem VAZIA nao e descartada aqui, e isso e deliberado. O#(lf)--      evento \"\"Grupo de '' para 'COI'\"\" prova a ENTRADA mesmo sem provar de onde#(lf)--      o chamado veio. Descartar a linha faria o SDM parecer sem cadeia e o#(lf)--      empurraria para o fallback - conclusao mais forte que a evidencia.#(lf)IF OBJECT_ID('tempdb..#RegEv') IS NOT NULL DROP TABLE #RegEv;#(lf)#(lf)SELECT#(lf)    g.id, g.system_time AS evento,#(lf)    CONVERT(nvarchar(200), LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(#(lf)        UPPER(LTRIM(RTRIM(ori.nome))), N' ', N'<>'), N'><', N''), N'<>', N' '))))#(lf)        COLLATE DATABASE_DEFAULT AS origem_norm,#(lf)    CONVERT(nvarchar(200), LTRIM(RTRIM(REPLACE(REPLACE(REPLACE(#(lf)        UPPER(LTRIM(RTRIM(des.nome))), N' ', N'<>'), N'><', N''), N'<>', N' '))))#(lf)        COLLATE DATABASE_DEFAULT AS destino_norm#(lf)INTO #RegEv#(lf)FROM #RegRaw AS g#(lf)CROSS APPLY (SELECT q1 = CHARINDEX(N'''', g.resto)) AS c1#(lf)CROSS APPLY (SELECT q2 = CASE WHEN c1.q1 > 0 THEN CHARINDEX(N'''', g.resto, c1.q1 + 1) ELSE 0 END) AS c2#(lf)CROSS APPLY (SELECT nome = CASE WHEN c2.q2 > c1.q1#(lf)                                THEN SUBSTRING(g.resto, c1.q1 + 1, c2.q2 - c1.q1 - 1) ELSE N'' END) AS ori#(lf)CROSS APPLY (SELECT posicao = CASE#(lf)        WHEN c2.q2 > 0 AND CHARINDEX(N' para ', g.resto, c2.q2) > 0 THEN CHARINDEX(N' para ', g.resto, c2.q2)#(lf)        WHEN c2.q2 > 0 THEN CHARINDEX(N' to ', g.resto, c2.q2)#(lf)        ELSE 0 END) AS sep#(lf)CROSS APPLY (SELECT q3 = CASE WHEN sep.posicao > 0 THEN CHARINDEX(N'''', g.resto, sep.posicao) ELSE 0 END) AS c3#(lf)CROSS APPLY (SELECT q4 = CASE WHEN c3.q3 > 0 THEN CHARINDEX(N'''', g.resto, c3.q3 + 1) ELSE 0 END) AS c4#(lf)CROSS APPLY (SELECT nome = CASE WHEN c4.q4 > c3.q3#(lf)                                THEN SUBSTRING(g.resto, c3.q3 + 1, c4.q4 - c3.q3 - 1) ELSE N'' END) AS des#(lf)WHERE c1.q1 > 0 AND c2.q2 > c1.q1 AND sep.posicao > 0 AND c3.q3 > 0 AND c4.q4 > c3.q3;#(lf)#(lf)CREATE CLUSTERED INDEX IX_RegEv ON #RegEv(id, evento);#(lf)#(lf)-- [R7] UMA linha por SDM com a DataRegistroCOI e a evidencia.#(lf)--#(lf)--      Todos os APPLY sao TOP (1) ou agregacao escalar: nao ha caminho por onde#(lf)--      um SDM se multiplique, e nao ha DISTINCT no final escondendo join que#(lf)--      multiplicou. A deduplicacao acontece na modelagem, nao no fim.#(lf)--#(lf)--      A janela ainda NAO foi aplicada aqui. Isso e proposital: a primeira#(lf)--      entrada tem de ser apurada sobre a vida inteira antes de qualquer#(lf)--      recorte, senao \"\"primeira entrada\"\" viraria \"\"primeira entrada da janela\"\".#(lf)IF OBJECT_ID('tempdb..#RegBase') IS NOT NULL DROP TABLE #RegBase;#(lf)#(lf)SELECT#(lf)    c.id, c.ref_num AS SDM, c.tipo, c.open_date, c.abertura_br,#(lf)    c.log_agent, c.group_id AS grupo_atual,#(lf)    CONVERT(nvarchar(200), ISNULL(gn.nome, N'')) COLLATE DATABASE_DEFAULT AS grupo_atual_nome,#(lf)    CONVERT(nvarchar(200), ISNULL(ig.grupo_init, N'')) COLLATE DATABASE_DEFAULT AS grupo_init,#(lf)    CONVERT(nvarchar(200), ISNULL(pri.origem_norm,  N'')) COLLATE DATABASE_DEFAULT AS grupo_hist_inicial,#(lf)    CONVERT(nvarchar(200), ISNULL(pri.destino_norm, N'')) COLLATE DATABASE_DEFAULT AS grupo_hist_destino,#(lf)    pri.evento   AS primeiro_evento_grupo,#(lf)    ev.n         AS qtd_evento_grupo,#(lf)    anc.n        AS qtd_ancora_grupo,#(lf)    -- ancoras ilegiveis antes do 1o evento legivel. Hoje TRAVA apenas o ramo#(lf)    -- historico; nos demais viaja como auditoria, para que o efeito de#(lf)    -- estende-la a eles seja MEDIDO antes de ser decidido.#(lf)    ilg.n        AS qtd_ancora_antes_do_1o,#(lf)    ent.entrada  AS primeiro_destino_coi,#(lf)    CONVERT(varchar(46), k.evidencia) COLLATE DATABASE_DEFAULT AS evidencia_coi,#(lf)    CONVERT(nvarchar(200), k.alias_evid) COLLATE DATABASE_DEFAULT AS alias_evidencia,#(lf)    k.data_registro,#(lf)    ic.init_consistente,#(lf)    CONVERT(nvarchar(40), tp.tipo_automacao) COLLATE DATABASE_DEFAULT AS tipo_automacao#(lf)INTO #RegBase#(lf)FROM #RegCand AS c#(lf)-- nome do grupo ATUAL: coluna de auditoria. Nao entra em nenhuma decisao de#(lf)-- evidencia - quem decide o fallback e o UUID, nao o nome de hoje.#(lf)OUTER APPLY (SELECT TOP (1) nome = LTRIM(RTRIM(CONCAT(ISNULL(g2.first_name, N''), N' ',#(lf)                                                      ISNULL(g2.last_name,  N''))))#(lf)             FROM dbo.ca_contact AS g2#(lf)             WHERE g2.contact_uuid = c.group_id) AS gn#(lf)-- %GROUP= do INIT: AUXILIAR. O primeiro, se houver mais de um evento INIT.#(lf)OUTER APPLY (SELECT TOP (1) t.grupo_init#(lf)             FROM #RegInitTag AS t#(lf)             WHERE t.id = c.id#(lf)             ORDER BY t.system_time, t.grupo_init) AS ig#(lf)-- assinatura de automacao do PRIMEIRO evento INIT. Mesmo criterio de desempate#(lf)-- de 'ig': o INIT mais antigo. Um chamado com varios INIT usa o da criacao.#(lf)OUTER APPLY (SELECT TOP (1) u.via_cmd, u.n_from, u.n_type, u.from_userid#(lf)             FROM #RegAutoTag AS u#(lf)             WHERE u.id = c.id#(lf)             ORDER BY u.system_time, u.from_userid) AS au#(lf)-- PRIMEIRO evento real de grupo da vida. Origem vazia NAO e filtrada: e o caso#(lf)-- em que a entrada se prova pelo destino.#(lf)OUTER APPLY (SELECT TOP (1) e.evento, e.origem_norm, e.destino_norm#(lf)             FROM #RegEv AS e#(lf)             WHERE e.id = c.id#(lf)             ORDER BY e.evento, e.origem_norm, e.destino_norm) AS pri#(lf)OUTER APPLY (SELECT n = COUNT(*) FROM #RegEv  AS e WHERE e.id = c.id) AS ev#(lf)OUTER APPLY (SELECT n = COUNT(*) FROM #RegRaw AS w WHERE w.id = c.id) AS anc#(lf)-- ancoras de grupo ANTERIORES ao primeiro evento legivel. Como 'pri' e o mais#(lf)-- antigo evento LEGIVEL, toda ancora estritamente anterior a ele e, por#(lf)-- definicao, ilegivel - nao precisa de anti-join para descobrir isso.#(lf)-- Sem evento legivel algum, conta todas, e o numero coincide com anc.n.#(lf)OUTER APPLY (SELECT n = COUNT(*) FROM #RegRaw AS w2#(lf)             WHERE w2.id = c.id#(lf)               AND w2.system_time < ISNULL(pri.evento, 2147483647)) AS ilg#(lf)-- PRIMEIRA entrada da VIDA no universo logico COI, pelo destino. Sem recorte de#(lf)-- janela: e isto que faz a reentrada nao contar duas vezes.#(lf)OUTER APPLY (SELECT entrada = MIN(e.evento)#(lf)             FROM #RegEv AS e#(lf)             WHERE e.id = c.id#(lf)               AND EXISTS (SELECT 1 FROM #AliasCOI AS a#(lf)                           WHERE a.nome_norm COLLATE Latin1_General_CI_AI#(lf)                               = e.destino_norm COLLATE Latin1_General_CI_AI)) AS ent#(lf)CROSS APPLY (SELECT#(lf)        pri_origem_coi = CASE WHEN EXISTS (#(lf)            SELECT 1 FROM #AliasCOI AS a#(lf)            WHERE a.nome_norm COLLATE Latin1_General_CI_AI#(lf)                = pri.origem_norm COLLATE Latin1_General_CI_AI) THEN 1 ELSE 0 END,#(lf)        pri_origem_legivel = CASE WHEN NULLIF(pri.origem_norm, N'') IS NOT NULL#(lf)                                  THEN 1 ELSE 0 END,#(lf)        -- origem = nome POSTERIOR da fila que antes da transicao era o COI#(lf)        pri_origem_contrato = CASE WHEN pri.origem_norm COLLATE Latin1_General_CI_AI#(lf)                                        = N'CONTRATO 7/2023 - COI' THEN 1 ELSE 0 END,#(lf)        atual_novo   = CASE WHEN c.group_id = @COI_UUID_Novo   THEN 1 ELSE 0 END,#(lf)        atual_antigo = CASE WHEN c.group_id = @COI_UUID_Antigo THEN 1 ELSE 0 END,#(lf)        antes_transicao = CASE WHEN c.open_date <= @TransIniEpoch THEN 1 ELSE 0 END,#(lf)        na_janela_transicao = CASE WHEN c.open_date >  @TransIniEpoch#(lf)                                    AND c.open_date <= @TransFimEpoch#(lf)                                   THEN 1 ELSE 0 END,#(lf)        -- o %GROUP= do INIT. Calculado AQUI, antes da hierarquia, porque agora#(lf)        -- ele participa como TRAVA - nao como decisor de data.#(lf)        init_eh_coi = CASE WHEN EXISTS (#(lf)            SELECT 1 FROM #AliasInit AS a#(lf)            WHERE a.nome_norm COLLATE Latin1_General_CI_AI#(lf)                = ig.grupo_init COLLATE Latin1_General_CI_AI) THEN 1 ELSE 0 END,#(lf)        -- INIT existe, e legivel (#RegInitTag so guarda valor nao vazio) e#(lf)        -- nomeia fila que nao pertence ao universo COI#(lf)        init_contradiz = CASE#(lf)            WHEN ig.grupo_init IS NULL THEN 0#(lf)            WHEN EXISTS (SELECT 1 FROM #AliasInit AS a#(lf)                         WHERE a.nome_norm COLLATE Latin1_General_CI_AI#(lf)                             = ig.grupo_init COLLATE Latin1_General_CI_AI) THEN 0#(lf)            ELSE 1 END,#(lf)        -- o INIT traz o nome que a fila so recebeu NA transicao. Num chamado#(lf)        -- aberto antes dela, isso e anomalia - nao compatibilidade.#(lf)        init_contrato = CASE WHEN ig.grupo_init COLLATE Latin1_General_CI_AI#(lf)                                  = N'CONTRATO 7/2023 - COI' THEN 1 ELSE 0 END,#(lf)        -- AUTOMACAO 1 - Task Scheduler / SESUC. UNICA que decide pertencimento.#(lf)        -- Os tres termos oficiais precisam valer ao mesmo tempo; nenhum deles#(lf)        -- sozinho classifica coisa alguma.#(lf)        auto_task_sched = CASE#(lf)            WHEN au.via_cmd = 1#(lf)             AND au.from_userid COLLATE Latin1_General_CI_AI = N'SERVICEDESK'#(lf)             AND EXISTS (SELECT 1 FROM #GrupoTaskSched AS gt#(lf)                         WHERE gt.nome_norm COLLATE Latin1_General_CI_AI#(lf)                             = ig.grupo_init COLLATE Latin1_General_CI_AI)#(lf)            THEN 1 ELSE 0 END,#(lf)        -- AUTOMACAO 2 - Zabbix. SO CLASSIFICA. Nao aparece em nenhum ramo da#(lf)        -- hierarquia de evidencia nem em data_registro.#(lf)        auto_zabbix = CASE#(lf)            WHEN @UUID_UsrAutomacoes IS NOT NULL#(lf)             AND c.log_agent = @UUID_UsrAutomacoes#(lf)             AND c.tipo = 'I'#(lf)            THEN 1 ELSE 0 END,#(lf)        -- AUTOMACAO 3 - Robo COI / Copilot Studio. SO CLASSIFICA. Assinatura#(lf)        -- tecnica OBSERVADA, nao criterio declarado: CMD + %FROM_USERID=#(lf)        -- duplicado + %TYPE= presente.#(lf)        auto_robo = CASE#(lf)            WHEN au.via_cmd = 1 AND au.n_from = 2 AND au.n_type >= 1#(lf)            THEN 1 ELSE 0 END) AS f#(lf)-- A hierarquia. A cadeia real e consultada PRIMEIRO e vence sempre; o fallback#(lf)-- de estado so e alcancado quando nao existe NENHUM evento de grupo.#(lf)CROSS APPLY (SELECT#(lf)        evidencia = CASE#(lf)            WHEN ev.n > 0 AND f.pri_origem_coi = 1#(lf)                 THEN 'ABERTO_NO_COI_CADEIA'#(lf)            -- TRAVA 1a: INIT anterior a transicao nao pode trazer o nome que a#(lf)            -- fila so recebeu depois. Vem ANTES da 1b porque #AliasInit aceita#(lf)            -- esse nome e, sozinha, deixaria o caso anomalo passar.#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.antes_transicao = 1#(lf)                         AND f.init_contrato = 1#(lf)                 THEN 'INIT_CONTRATO_INCOMPATIVEL_COM_DATA_ABERTURA'#(lf)            -- TRAVA 1b: o registro de abertura nomeia fila nao-COI. A origem#(lf)            -- historica nao pode sobrepor evidencia contemporanea da abertura.#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.antes_transicao = 1#(lf)                         AND f.init_contradiz = 1#(lf)                 THEN 'CONTRADICAO_INIT_x_CADEIA'#(lf)            -- TRAVA 2: ha ancora ilegivel antes do 1o evento legivel, entao ele#(lf)            -- pode nao ser o primeiro da vida e sua origem nao descreve a abertura#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.antes_transicao = 1#(lf)                         AND ilg.n > 0#(lf)                 THEN 'SEM_RECONSTRUCAO_EVENTO_ILEGIVEL'#(lf)            -- origem e o rotulo posterior da fila antiga: ja era COI na abertura#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.antes_transicao = 1#(lf)                 THEN 'JA_ESTAVA_NO_COI_HISTORICO'#(lf)            -- origem 'CONTRATO' dentro da janela: o nome nao prova de onde o#(lf)            -- chamado veio, mas se ha evento com destino em fila COI a entrada#(lf)            -- esta provada e datada. A ambiguidade impede antecipar para#(lf)            -- open_date, nao apaga a entrada.#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.na_janela_transicao = 1#(lf)                         AND ent.entrada IS NOT NULL#(lf)                 THEN 'ENTRADA_DEMONSTRAVEL_DESTINO'#(lf)            -- sem entrada demonstravel: ai sim nao se sabe SE entrou#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.na_janela_transicao = 1#(lf)                 THEN 'AMBIGUO_JANELA_TRANSICAO'#(lf)            WHEN ev.n > 0 AND f.pri_origem_legivel = 1 AND ent.entrada IS NOT NULL#(lf)                 THEN 'TRANSFERIDO_PARA_COI'#(lf)            WHEN ev.n > 0 AND ent.entrada IS NOT NULL#(lf)                 THEN 'ENTRADA_DEMONSTRAVEL_DESTINO'#(lf)            -- AUTOMACAO como ULTIMO recurso do ramo com cadeia: o chamado tem#(lf)            -- eventos de grupo, nenhum deles toca o COI, e antes disso ele#(lf)            -- terminava em NAO_ENTRA. Nenhum ramo acima muda de resultado.#(lf)            WHEN ev.n > 0 AND f.auto_task_sched = 1#(lf)                 THEN 'AUTOMACAO_TASK_SCHEDULER'#(lf)            WHEN ev.n > 0#(lf)                 THEN 'NAO_ENTRA'#(lf)            WHEN anc.n > 0#(lf)                 THEN 'SEM_RECONSTRUCAO_EVENTO_ILEGIVEL'#(lf)            WHEN f.atual_novo = 1#(lf)                 THEN 'ABERTO_NO_COI_INFERIDO_GRUPO_ATUAL'#(lf)            WHEN f.atual_antigo = 1 AND f.antes_transicao = 1#(lf)                 THEN 'ABERTO_NO_COI_INFERIDO_GRUPO_ATUAL_HISTORICO'#(lf)            WHEN f.atual_antigo = 1 AND f.na_janela_transicao = 1#(lf)                 THEN 'AMBIGUO_JANELA_TRANSICAO'#(lf)            -- AUTOMACAO como ULTIMO recurso do ramo sem cadeia: e o caso dos#(lf)            -- chamados que nascem direto na fila do NSTI ou do fornecedor e#(lf)            -- nunca produzem evento de grupo.#(lf)            WHEN f.auto_task_sched = 1#(lf)                 THEN 'AUTOMACAO_TASK_SCHEDULER'#(lf)            ELSE 'NAO_ENTRA' END,#(lf)        alias_evid = CASE#(lf)            WHEN ev.n > 0 AND f.pri_origem_coi = 1       THEN pri.origem_norm#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.antes_transicao = 1#(lf)                         AND f.init_contrato = 1         THEN ig.grupo_init#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.antes_transicao = 1#(lf)                         AND f.init_contradiz = 1        THEN ig.grupo_init#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.antes_transicao = 1#(lf)                         AND ilg.n > 0                   THEN N'(ancora ilegivel antes do 1o evento)'#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.antes_transicao = 1#(lf)                                                         THEN pri.origem_norm#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.na_janela_transicao = 1#(lf)                         AND ent.entrada IS NOT NULL     THEN N'(destino COI na 1a entrada)'#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.na_janela_transicao = 1#(lf)                                                         THEN pri.origem_norm#(lf)            WHEN ev.n > 0 AND ent.entrada IS NOT NULL    THEN N'(destino COI na 1a entrada)'#(lf)            WHEN ev.n > 0 AND f.auto_task_sched = 1      THEN ig.grupo_init#(lf)            WHEN ev.n > 0                                THEN NULL#(lf)            WHEN anc.n > 0                               THEN N'(evento de grupo ilegivel)'#(lf)            WHEN f.atual_novo = 1                        THEN N'COI'#(lf)            WHEN f.atual_antigo = 1 AND f.antes_transicao = 1#(lf)                                                         THEN N'CONTRATO 7/2023 - COI'#(lf)            WHEN f.atual_antigo = 1 AND f.na_janela_transicao = 1#(lf)                                                         THEN N'CONTRATO 7/2023 - COI'#(lf)            -- a fila em que a automacao registrou. NAO e alias do COI: e o#(lf)            -- destino oficial do agendamento, e a coluna diz exatamente isso.#(lf)            WHEN f.auto_task_sched = 1                   THEN ig.grupo_init#(lf)            ELSE NULL END,#(lf)        data_registro = CASE#(lf)            WHEN ev.n > 0 AND f.pri_origem_coi = 1       THEN c.open_date#(lf)            -- as duas ressalvas recebem data so para poderem ser filtradas por#(lf)            -- periodo em #RegRessalvas. Elas nao entram em #Registrados.#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.antes_transicao = 1#(lf)                         AND f.init_contrato = 1         THEN c.open_date#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.antes_transicao = 1#(lf)                         AND f.init_contradiz = 1        THEN c.open_date#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.antes_transicao = 1#(lf)                         AND ilg.n > 0                   THEN c.open_date#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.antes_transicao = 1#(lf)                                                         THEN c.open_date#(lf)            -- dentro da janela COM entrada demonstravel: data e a ENTRADA,#(lf)            -- nunca open_date - a abertura nao e demonstravel como 1a entrada#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.na_janela_transicao = 1#(lf)                         AND ent.entrada IS NOT NULL     THEN ent.entrada#(lf)            -- ressalva de janela recebe data so para poder ser filtrada por periodo#(lf)            WHEN ev.n > 0 AND f.pri_origem_contrato = 1 AND f.na_janela_transicao = 1#(lf)                                                         THEN c.open_date#(lf)            WHEN ev.n > 0 AND ent.entrada IS NOT NULL    THEN ent.entrada#(lf)            WHEN ev.n > 0 AND f.auto_task_sched = 1      THEN c.open_date#(lf)            WHEN ev.n > 0                                THEN NULL#(lf)            -- as duas linhas abaixo recebem data SO para poderem ser filtradas#(lf)            -- por periodo em #RegRessalvas. Elas nao entram em #Registrados.#(lf)            WHEN anc.n > 0                               THEN c.open_date#(lf)            WHEN f.atual_novo = 1                        THEN c.open_date#(lf)            WHEN f.atual_antigo = 1 AND f.antes_transicao = 1#(lf)                                                         THEN c.open_date#(lf)            WHEN f.atual_antigo = 1 AND f.na_janela_transicao = 1#(lf)                                                         THEN c.open_date#(lf)            -- pertencimento exclusivamente por automacao: a data e a ABERTURA.#(lf)            -- Nao ha entrada em fila COI para datar, e inventar uma seria pior#(lf)            -- do que usar o unico instante demonstravel do registro.#(lf)            WHEN f.auto_task_sched = 1                   THEN c.open_date#(lf)            ELSE NULL END) AS k#(lf)-- auditoria do rotulo: o %GROUP= da abertura concorda com o que a cadeia mostra?#(lf)-- f.init_eh_coi ja foi calculado acima, porque a hierarquia precisa dele.#(lf)CROSS APPLY (SELECT init_consistente = CASE#(lf)        WHEN ig.grupo_init IS NULL THEN NULL#(lf)        -- por construcao alias_evidencia = grupo_init neste ramo: o rotulo da#(lf)        -- abertura e exatamente a fila que a regra afirma. Nao ha o que#(lf)        -- contradizer, com %GROUP=COI ou com qualquer outra fila da lista.#(lf)        WHEN k.evidencia = 'AUTOMACAO_TASK_SCHEDULER' THEN CONVERT(bit, 1)#(lf)        WHEN f.init_eh_coi = 1 AND k.evidencia IN (#(lf)                 'ABERTO_NO_COI_CADEIA',#(lf)                 'JA_ESTAVA_NO_COI_HISTORICO',#(lf)                 'ABERTO_NO_COI_INFERIDO_GRUPO_ATUAL',#(lf)                 'ABERTO_NO_COI_INFERIDO_GRUPO_ATUAL_HISTORICO') THEN CONVERT(bit, 1)#(lf)        WHEN f.init_eh_coi = 0 AND k.evidencia NOT IN (#(lf)                 'ABERTO_NO_COI_CADEIA',#(lf)                 'JA_ESTAVA_NO_COI_HISTORICO',#(lf)                 'ABERTO_NO_COI_INFERIDO_GRUPO_ATUAL',#(lf)                 'ABERTO_NO_COI_INFERIDO_GRUPO_ATUAL_HISTORICO') THEN CONVERT(bit, 1)#(lf)        ELSE CONVERT(bit, 0) END) AS ic#(lf)-- MODALIDADE DE AUTOMACAO - coluna INFORMATIVA.#(lf)--#(lf)--   Nao participa de nenhuma decisao de pertencimento nem de data. Serve para#(lf)--   explicar a ORIGEM do registro ao lado de evidencia_coi, que explica por que#(lf)--   e quando o chamado entrou.#(lf)--#(lf)--   As tres assinaturas sao disjuntas nos dados observados - servicedesk contra#(lf)--   matricula, %FROM_USERID= unico contra duplicado, CMD contra ausencia de#(lf)--   CMD. A ordem do CASE existe so para tornar o resultado determinista caso#(lf)--   alguma delas passe a se sobrepor no futuro; a consulta de validacao mede se#(lf)--   isso aconteceu, em vez de confiar na ordem.#(lf)--#(lf)--   'Criado via interface CMD' por servicedesk com %GROUP= FORA da lista#(lf)--   oficial fica deliberadamente NAO classificado. A modalidade oficial e a#(lf)--   trinca inteira, e a validacao conta esses casos para que a lacuna seja#(lf)--   visivel e nao silenciosa.#(lf)CROSS APPLY (SELECT tipo_automacao = CASE#(lf)        WHEN f.auto_task_sched = 1 THEN N'Task Scheduler / SESUC'#(lf)        WHEN f.auto_zabbix     = 1 THEN N'Zabbix Monitor'#(lf)        WHEN f.auto_robo       = 1 THEN N'Robo COI'#(lf)        ELSE NULL END) AS tp#(lf)WHERE k.evidencia <> 'NAO_ENTRA';#(lf)#(lf)CREATE UNIQUE CLUSTERED INDEX IX_RegBase ON #RegBase(id);#(lf)#(lf)-- [R8] A janela e aplicada AGORA, sobre DataRegistroCOI - e nao sobre#(lf)--      open_date. E aqui que o eixo temporal do indicador muda de fato.#(lf)--#(lf)--      As duas categorias de ressalva saem do indicador e vao para#(lf)--      #RegRessalvas. Elas nao sao descartadas em silencio: a consulta de#(lf)--      validacao as lista, para que a consequencia seja medida e nao suposta.#(lf)IF OBJECT_ID('tempdb..#Registrados') IS NOT NULL DROP TABLE #Registrados;#(lf)#(lf)SELECT#(lf)    b.id, b.SDM, b.tipo, b.abertura_br, b.log_agent,#(lf)    b.grupo_atual, b.grupo_atual_nome,#(lf)    b.grupo_init, b.grupo_hist_inicial, b.grupo_hist_destino,#(lf)    b.qtd_evento_grupo, b.qtd_ancora_grupo, b.qtd_ancora_antes_do_1o,#(lf)    b.init_consistente, b.tipo_automacao,#(lf)    b.evidencia_coi, b.alias_evidencia, b.data_registro,#(lf)    DATEADD(HOUR, -@HorasBrasilParaUTC, DATEADD(SECOND, b.data_registro, @Epoch)) AS registro_br,#(lf)    CASE WHEN b.primeiro_evento_grupo IS NULL THEN NULL#(lf)         ELSE DATEADD(HOUR, -@HorasBrasilParaUTC,#(lf)                      DATEADD(SECOND, b.primeiro_evento_grupo, @Epoch)) END AS primeiro_evento_grupo_br,#(lf)    CASE WHEN b.primeiro_destino_coi IS NULL THEN NULL#(lf)         ELSE DATEADD(HOUR, -@HorasBrasilParaUTC,#(lf)                      DATEADD(SECOND, b.primeiro_destino_coi, @Epoch)) END AS primeira_transf_coi_br,#(lf)    CONVERT(bit, CASE WHEN b.open_date < @InicioEpoch THEN 1 ELSE 0 END) AS aberto_antes_periodo,#(lf)    CONVERT(bit, CASE WHEN b.data_registro < b.open_date THEN 1 ELSE 0 END) AS anomalia_data#(lf)INTO #Registrados#(lf)FROM #RegBase AS b#(lf)WHERE b.data_registro >= @InicioEpoch#(lf)  AND b.data_registro <  @FimEpoch#(lf)  AND b.evidencia_coi NOT IN ('AMBIGUO_JANELA_TRANSICAO',#(lf)                              'SEM_RECONSTRUCAO_EVENTO_ILEGIVEL',#(lf)                              'CONTRADICAO_INIT_x_CADEIA',#(lf)                              'INIT_CONTRATO_INCOMPATIVEL_COM_DATA_ABERTURA');#(lf)#(lf)-- Indice NAO unico de proposito: se algum dia a regra passar a duplicar SDM, o#(lf)-- erro deve aparecer numa conferencia COUNT(*) x COUNT(DISTINCT SDM), e nao#(lf)-- como falha bruta de criacao de indice que esconde o diagnostico.#(lf)CREATE CLUSTERED INDEX IX_Registrados ON #Registrados(id);#(lf)#(lf)-- [R9] RESSALVAS - candidatos do periodo que a regra NAO conta, e por que.#(lf)--      Existe para que \"\"ficou de fora\"\" seja um numero conferivel, com os SDMs#(lf)--      nominais, e nao uma nota de rodape.#(lf)IF OBJECT_ID('tempdb..#RegRessalvas') IS NOT NULL DROP TABLE #RegRessalvas;#(lf)#(lf)SELECT#(lf)    b.id, b.SDM, b.tipo, b.abertura_br, b.grupo_atual, b.grupo_atual_nome,#(lf)    b.grupo_init, b.grupo_hist_inicial, b.grupo_hist_destino,#(lf)    b.qtd_evento_grupo, b.qtd_ancora_grupo, b.qtd_ancora_antes_do_1o,#(lf)    b.evidencia_coi, b.alias_evidencia, b.tipo_automacao,#(lf)    DATEADD(HOUR, -@HorasBrasilParaUTC, DATEADD(SECOND, b.data_registro, @Epoch)) AS referencia_br#(lf)INTO #RegRessalvas#(lf)FROM #RegBase AS b#(lf)WHERE b.data_registro >= @InicioEpoch#(lf)  AND b.data_registro <  @FimEpoch#(lf)  AND b.evidencia_coi IN ('AMBIGUO_JANELA_TRANSICAO',#(lf)                          'SEM_RECONSTRUCAO_EVENTO_ILEGIVEL',#(lf)                          'CONTRADICAO_INIT_x_CADEIA',#(lf)                          'INIT_CONTRATO_INCOMPATIVEL_COM_DATA_ABERTURA');#(lf)#(lf)CREATE CLUSTERED INDEX IX_RegRessalvas ON #RegRessalvas(id);#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- FIM REGRA CANONICA DE REGISTRADOS COI#(lf)--------------------------------------------------------------------------------#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- INICIO REGRA OFICIAL DE ENCERRADOS COI  (NAO ALTERAR SEM REVALIDAR)#(lf)--#(lf)-- Identica a queries/consulta_coi_encerrados.sql, inclusive a validacao do grupo#(lf)-- alvo:#(lf)--     close_date na janela  E  type IN ('I','R')  E  status IN ('CL','CLUNRSLV')#(lf)--     E  group_id ATUAL = @COI_GrupoAlvo, que precisa existir, estar ativo e ter#(lf)--     ao menos um membro em grpmem.#(lf)--------------------------------------------------------------------------------#(lf)DECLARE @GrupoNome     nvarchar(200);#(lf)DECLARE @GrupoInativo  int;#(lf)DECLARE @GrupoMembros  bigint;#(lf)#(lf)SELECT#(lf)    @GrupoNome    = LTRIM(RTRIM(COALESCE(NULLIF(c.last_name, N''), NULLIF(c.userid, N''), N'(sem nome)'))),#(lf)    @GrupoInativo = c.inactive#(lf)FROM dbo.ca_contact AS c#(lf)WHERE c.contact_uuid = @COI_GrupoAlvo;#(lf)#(lf)SELECT @GrupoMembros = COUNT_BIG(*)#(lf)FROM dbo.grpmem AS gm#(lf)WHERE gm.group_id = @COI_GrupoAlvo;#(lf)#(lf)DECLARE @GrupoAlvoValido bit =#(lf)    CASE WHEN @GrupoNome IS NOT NULL AND @GrupoInativo = 0 AND @GrupoMembros > 0#(lf)         THEN 1 ELSE 0 END;#(lf)#(lf)IF @GrupoAlvoValido = 0#(lf)    PRINT N'ATENCAO: o grupo alvo NAO passa no filtro da Consulta para Auditoria '#(lf)        + N'(precisa existir, estar com inactive = 0 e ter ao menos um membro em grpmem). '#(lf)        + N'A serie Encerrados sera ZERO por causa disso, e nao por ausencia de encerramentos.';#(lf)#(lf)IF OBJECT_ID('tempdb..#EncerradosCOI') IS NOT NULL DROP TABLE #EncerradosCOI;#(lf)#(lf)SELECT#(lf)    r.id,#(lf)    r.persid,#(lf)    r.ref_num AS SDM,#(lf)    r.close_date,#(lf)    r.assignee,#(lf)    DATEADD(HOUR, -@HorasBrasilParaUTC, DATEADD(SECOND, r.close_date, @Epoch)) AS encerramento_br#(lf)INTO #EncerradosCOI#(lf)FROM dbo.call_req AS r#(lf)WHERE r.close_date >= @InicioEpoch#(lf)  AND r.close_date <  @FimEpoch#(lf)  AND r.[type]   IN ('I', 'R')#(lf)  AND r.status   IN ('CL', 'CLUNRSLV')#(lf)  AND r.group_id = @COI_GrupoAlvo#(lf)  AND @GrupoAlvoValido = 1#(lf)OPTION (RECOMPILE);#(lf)#(lf)CREATE UNIQUE CLUSTERED INDEX IX_EncerradosCOI ON #EncerradosCOI(id);#(lf)--------------------------------------------------------------------------------#(lf)-- FIM REGRA OFICIAL DE ENCERRADOS COI#(lf)--------------------------------------------------------------------------------#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- [E1] QUEM ENCERROU - o ultimo evento de status ou de solucao ate o close_date.#(lf)--#(lf)--      TOP (1) por chamado, entao cada encerramento recebe no maximo UMA conta.#(lf)--      Sem nenhum evento desses tipos ate o close_date, o analista fica NULL e#(lf)--      o encerramento conta como 'Não identificado' - nao e descartado.#(lf)--------------------------------------------------------------------------------#(lf)IF OBJECT_ID('tempdb..#Encerrador') IS NOT NULL DROP TABLE #Encerrador;#(lf)#(lf)SELECT#(lf)    e.id,#(lf)    e.SDM,#(lf)    e.encerramento_br,#(lf)    ult.analyst,#(lf)    ult.tipo_evento,#(lf)    CASE WHEN ult.system_time IS NULL THEN NULL#(lf)         ELSE e.close_date - ult.system_time END AS segundos_ate_encerramento#(lf)INTO #Encerrador#(lf)FROM #EncerradosCOI AS e#(lf)OUTER APPLY (#(lf)    SELECT TOP (1)#(lf)        al.analyst,#(lf)        CONVERT(varchar(12), al.[type]) AS tipo_evento,#(lf)        al.system_time#(lf)    FROM dbo.act_log AS al#(lf)    WHERE al.call_req_id = e.persid#(lf)      AND al.system_time IS NOT NULL#(lf)      AND al.system_time <= e.close_date#(lf)      AND al.[type] IN ('CL', 'ST', 'CLREQ', 'RE', 'RO', 'SOLN')#(lf)    ORDER BY al.system_time DESC, al.id DESC#(lf)) AS ult;#(lf)#(lf)CREATE UNIQUE CLUSTERED INDEX IX_Encerrador ON #Encerrador(id);#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- [M1] ATRIBUICOES - uma linha por chamado e por serie (R registro, E quem#(lf)--      encerrou, A responsavel atual do encerrado), com o mes da data que#(lf)--      alimenta a serie e a conta atribuida. Nenhuma linha some: conta NULL vira#(lf)--      'Não identificado', com o motivo no nome.#(lf)--------------------------------------------------------------------------------#(lf)IF OBJECT_ID('tempdb..#Atribuicao') IS NOT NULL DROP TABLE #Atribuicao;#(lf)#(lf)SELECT#(lf)    'R' AS serie,#(lf)    YEAR(r.registro_br)  AS Ano,#(lf)    MONTH(r.registro_br) AS Mes,#(lf)    r.log_agent          AS conta,#(lf)    CONVERT(nvarchar(60), N'(sem registrador no chamado)') AS sem_conta#(lf)INTO #Atribuicao#(lf)FROM #Registrados AS r#(lf)UNION ALL#(lf)SELECT#(lf)    'E',#(lf)    YEAR(x.encerramento_br),#(lf)    MONTH(x.encerramento_br),#(lf)    x.analyst,#(lf)    CONVERT(nvarchar(60), N'(encerramento sem evento de status)')#(lf)FROM #Encerrador AS x#(lf)UNION ALL#(lf)SELECT#(lf)    'A',#(lf)    YEAR(e.encerramento_br),#(lf)    MONTH(e.encerramento_br),#(lf)    e.assignee,#(lf)    CONVERT(nvarchar(60), N'(encerrado sem responsável)')#(lf)FROM #EncerradosCOI AS e;#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- [M2] CLASSIFICACAO DAS CONTAS que aparecem nas atribuicoes.#(lf)--      Uma linha por conta: contact_uuid e a chave de ca_contact; grpmem entra#(lf)--      so em EXISTS, que nao multiplica linha.#(lf)--------------------------------------------------------------------------------#(lf)IF OBJECT_ID('tempdb..#Conta') IS NOT NULL DROP TABLE #Conta;#(lf)#(lf)SELECT#(lf)    u.conta,#(lf)    c.contact_uuid,#(lf)    NULLIF(LTRIM(RTRIM(c.userid)), N'') AS userid,#(lf)    CASE#(lf)        WHEN c.contact_uuid IS NULL THEN N'(UUID sem contato em ca_contact)'#(lf)        WHEN (ISNULL(c.first_name, N'') <> N'' OR ISNULL(c.last_name, N'') <> N'')#(lf)            THEN LTRIM(RTRIM(CONCAT(ISNULL(c.first_name, N''), N' ', ISNULL(c.last_name, N''))))#(lf)        WHEN ISNULL(c.userid, N'') <> N'' THEN LTRIM(RTRIM(c.userid))#(lf)        ELSE N'(contato sem nome)'#(lf)    END AS nome,#(lf)    CONVERT(nvarchar(40), CASE#(lf)        WHEN c.contact_uuid IS NULL THEN N'Não identificado'#(lf)        WHEN c.userid COLLATE Latin1_General_CI_AI IN (N'USR_AUTOMACOES', N'SESUC_AUTO')#(lf)          OR c.userid COLLATE Latin1_General_CI_AI LIKE N'%SERVICEDESK%'#(lf)          OR CONCAT(c.first_name, N' ', c.last_name) COLLATE Latin1_General_CI_AI LIKE N'%SERVICEDESK%'#(lf)          OR CONCAT(c.first_name, N' ', c.last_name) COLLATE Latin1_General_CI_AI LIKE N'%SERVICE DESK%'#(lf)            THEN N'Conta técnica / automação'#(lf)        WHEN EXISTS (SELECT 1 FROM dbo.grpmem AS gm#(lf)                     WHERE gm.member = c.contact_uuid#(lf)                       AND gm.group_id IN (@COI_Novo, @COI_Antigo))#(lf)            THEN N'Membro do grupo COI'#(lf)        ELSE N'Fora do grupo COI'#(lf)    END) AS tipo_conta#(lf)INTO #Conta#(lf)FROM (SELECT DISTINCT a.conta FROM #Atribuicao AS a WHERE a.conta IS NOT NULL) AS u#(lf)LEFT JOIN dbo.ca_contact AS c#(lf)    ON c.contact_uuid = u.conta;#(lf)#(lf)CREATE UNIQUE CLUSTERED INDEX IX_Conta ON #Conta(conta);#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- RESULTADO - Registrados x Encerrados por mes e por conta#(lf)--------------------------------------------------------------------------------#(lf)SELECT#(lf)    a.Ano,#(lf)    a.Mes,#(lf)    CONVERT(char(7), CONCAT(a.Ano, N'-', RIGHT(CONCAT(N'0', a.Mes), 2))) AS MesAno,#(lf)    a.conta                                                     AS MembroUUID,#(lf)    ISNULL(k.userid, N'-')                                      AS MembroUserID,#(lf)    CASE WHEN a.conta IS NULL THEN a.sem_conta ELSE k.nome END  AS Membro,#(lf)    CASE WHEN a.conta IS NULL THEN N'Não identificado' ELSE k.tipo_conta END AS TipoConta,#(lf)    SUM(CASE WHEN a.serie = 'R' THEN 1 ELSE 0 END)              AS Registrados,#(lf)    SUM(CASE WHEN a.serie = 'E' THEN 1 ELSE 0 END)              AS Encerrados,#(lf)    SUM(CASE WHEN a.serie = 'A' THEN 1 ELSE 0 END)              AS EncerradosComoResponsavel#(lf)FROM #Atribuicao AS a#(lf)LEFT JOIN #Conta AS k#(lf)    ON k.conta = a.conta#(lf)GROUP BY#(lf)    a.Ano, a.Mes, a.conta, k.userid,#(lf)    CASE WHEN a.conta IS NULL THEN a.sem_conta ELSE k.nome END,#(lf)    CASE WHEN a.conta IS NULL THEN N'Não identificado' ELSE k.tipo_conta END#(lf)ORDER BY#(lf)    a.Ano, a.Mes,#(lf)    SUM(CASE WHEN a.serie = 'R' THEN 1 ELSE 0 END) + SUM(CASE WHEN a.serie = 'E' THEN 1 ELSE 0 END) DESC,#(lf)    Membro;#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- DIAGNOSTICO (opcional) - a quem cada encerramento foi atribuido, e por qual#(lf)-- evento. Le a temp table do passo [E1]; a regra nao e reescrita aqui.#(lf)--------------------------------------------------------------------------------#(lf)IF @MostrarDiagnostico = 1#(lf)SELECT#(lf)    x.SDM,#(lf)    x.encerramento_br AS DataEncerramento,#(lf)    x.analyst         AS EncerradoPorUUID,#(lf)    ISNULL(k.userid, N'-') AS EncerradoPorUserID,#(lf)    CASE WHEN x.analyst IS NULL THEN N'(encerramento sem evento de status)' ELSE k.nome END AS EncerradoPor,#(lf)    CASE WHEN x.analyst IS NULL THEN N'Não identificado' ELSE k.tipo_conta END AS TipoConta,#(lf)    ISNULL(x.tipo_evento, N'-') AS EventoUsado,#(lf)    x.segundos_ate_encerramento AS SegundosAteEncerramento,#(lf)    ISNULL(kr.nome, N'(encerrado sem responsável)') AS ResponsavelAtual#(lf)FROM #Encerrador AS x#(lf)JOIN #EncerradosCOI AS e#(lf)    ON e.id = x.id#(lf)LEFT JOIN #Conta AS k#(lf)    ON k.conta = x.analyst#(lf)LEFT JOIN #Conta AS kr#(lf)    ON kr.conta = e.assignee#(lf)ORDER BY x.encerramento_br, x.SDM;#(lf)\",\n    Fonte = #\"Executar consulta COI\"(Sql),\n    ComMes = Table.AddColumn(Fonte, \"MesInicio\", each #date([Ano], [Mes], 1), type date)\nin\n    ComMes"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navegação"
          }
        ],
        "description": "Um mês e uma conta por linha. Fonte: consulta_coi_registrados_encerrados_por_membro_power_bi.sql"
      },
