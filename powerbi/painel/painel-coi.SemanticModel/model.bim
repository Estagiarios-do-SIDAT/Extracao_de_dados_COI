            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "dd/mm/yyyy",
            "isHidden": true,
            "description": "Data (sem hora) de DataEncerramento; liga ao Calendário COI."
          }
        ],
        "partitions": [
          {
            "name": "Pesquisas de Satisfação",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Sql = \"USE mdb;#(lf)SET NOCOUNT ON;#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- VERSAO POWER BI de queries/consulta_coi_pesquisa_satisfacao_encerrados_detalhe.sql#(lf)--#(lf)-- A regra e a da consulta de /queries, que e a fonte de verdade. Este arquivo#(lf)-- e o texto dela sem alteracao, exceto pelas adaptacoes abaixo, marcadas no#(lf)-- corpo com [POWER BI]. Se esta versao e a fonte divergirem, vale a fonte.#(lf)--#(lf)-- Adaptacoes:#(lf)--   - periodo automatico: os meses de calendario COMPLETOS anteriores ao mes#(lf)--     corrente - ate @PBI_QuantidadeMeses, a partir de @PBI_InicioMinimoBR -,#(lf)--     no lugar das datas digitadas;#(lf)--   - saida: a fonte ja devolve um unico result set, que sai sem alteracao.#(lf)--#(lf)-- Power BI: conector SQL Server, banco mdb, modo Importacao, este arquivo#(lf)-- inteiro no campo Instrucao SQL, Adicionar colunas de relacao desmarcado.#(lf)-- Somente leitura. Batch unico, sem GO.#(lf)--------------------------------------------------------------------------------#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- [POWER BI] PERIODO AUTOMATICO#(lf)--#(lf)-- A fonte recebe o periodo digitado, em meses de calendario com fim EXCLUSIVO.#(lf)-- Aqui ele e calculado a cada atualizacao, na mesma forma:#(lf)--#(lf)--     fim    (exclusivo) = dia 1 do mes corrente, 00:00:00, horario do Brasil#(lf)--     inicio (inclusivo) = @PBI_QuantidadeMeses meses antes do fim, mas nunca#(lf)--                          antes de @PBI_InicioMinimoBR#(lf)--#(lf)-- Entram so meses COMPLETOS: o mes em andamento fica de fora. As consultas do#(lf)-- painel usam todas este MESMO periodo, para que o filtro Mes/Ano enxergue os#(lf)-- mesmos meses em todas as paginas.#(lf)--#(lf)-- @PBI_InicioMinimoBR = 01/03/2026: mes em que o novo COI passou a usar o#(lf)-- codigo de fornecedor atual, o grupo alvo de Encerrados (@COI_Novo). Marco#(lf)-- entra INTEIRO. Antes dele, os encerramentos sao do grupo antigo - outro#(lf)-- contrato, que a regra de Encerrados nao soma -, e o painel mostraria meses#(lf)-- sem Encerrados ao lado de meses com Registrados. O piso so muda se mudar o#(lf)-- grupo alvo.#(lf)--#(lf)-- @PBI_QuantidadeMeses vem do parametro QtdMesesCompletosCOI do Power Query,#(lf)-- o MESMO nas seis consultas. O Power Query troca o 12 da linha abaixo pela#(lf)-- referencia @QtdMesesCompletosCOI e executa o lote com esse parametro SQL#(lf)-- (Value.NativeQuery, sp_executesql); ver powerbi/powerbi-query.md, secao 3.#(lf)-- O 12 vale so quando o arquivo roda fora do Power BI. Nao mude o texto da#(lf)-- linha: o Power Query a localiza por ele e falha se nao a encontrar.#(lf)--------------------------------------------------------------------------------#(lf)DECLARE @PBI_QuantidadeMeses int = 12;#(lf)DECLARE @PBI_InicioMinimoBR datetime2(0) = '2026-03-01 00:00:00';#(lf)#(lf)IF @PBI_QuantidadeMeses IS NULL OR @PBI_QuantidadeMeses < 1#(lf)    THROW 50001, N'[POWER BI] QtdMesesCompletosCOI deve ser um inteiro positivo.', 1;#(lf)#(lf)DECLARE @PBI_HojeBR date =#(lf)    CONVERT(date, DATEADD(HOUR, -3, SYSUTCDATETIME()));#(lf)DECLARE @PBI_FimBR datetime2(0) =#(lf)    CONVERT(datetime2(0), DATEFROMPARTS(YEAR(@PBI_HojeBR), MONTH(@PBI_HojeBR), 1));#(lf)-- Fim e piso sao dias 1: \"\"n meses antes do fim depois do piso\"\" equivale a#(lf)-- \"\"n menor que os meses entre piso e fim\"\", e esta forma nao estoura o#(lf)-- DATEADD quando n e muito grande.#(lf)DECLARE @PBI_InicioBR datetime2(0) =#(lf)    CASE WHEN @PBI_QuantidadeMeses < DATEDIFF(MONTH, @PBI_InicioMinimoBR, @PBI_FimBR)#(lf)         THEN DATEADD(MONTH, -@PBI_QuantidadeMeses, @PBI_FimBR)#(lf)         ELSE @PBI_InicioMinimoBR END;#(lf)#(lf)#(lf)/*#(lf)================================================================================#(lf)COI - PESQUISA DE SATISFACAO DOS ENCERRADOS - detalhe, uma linha por SDM#(lf)================================================================================#(lf)#(lf)Saida: UM unico result set, UMA linha por chamado ENCERRADO pelo COI no periodo.#(lf)#(lf)    SDM, TipoChamado, DataEncerramento, Ano, Mes, MesAno,#(lf)    StatusSatisfacao, PerguntaAvaliada, RespostaSatisfacao,#(lf)    QtdPerguntasRespondidas, DataPesquisa,#(lf)    PesquisaSolicitada, QtdSolicitacoesPesquisa, DataSolicitacaoPesquisa,#(lf)    SolicitacaoPesquisa#(lf)#(lf)POR QUE ESTA CONSULTA EXISTE#(lf)#(lf)    consulta_coi_pesquisa_satisfacao_encerrados.sql responde a mesma pergunta em#(lf)    duas janelas: um resumo (Com x Sem satisfacao) e uma lista dos SDMs com a#(lf)    opcao escolhida. Nenhuma das duas traz DATA, e o resumo e agregado. Um#(lf)    painel filtrado por Mes/Ano nao consegue usar nenhuma delas. Esta consulta#(lf)    entrega a MESMA classificacao, chamado a chamado, com a data de encerramento#(lf)    - o resumo e a lista da consulta original sao agrupamentos desta saida.#(lf)#(lf)A REGRA NAO E NOVA#(lf)#(lf)    Populacao: os Encerrados pelo COI, LITERALMENTE como em#(lf)    consulta_coi_encerrados.sql e consulta_coi_pesquisa_satisfacao_encerrados.sql:#(lf)#(lf)        close_date >= @DataInicio  e  < @DataFim   (semiaberto)#(lf)        type       IN ('I','R')#(lf)        status     IN ('CL','CLUNRSLV')#(lf)        group_id   =  @COI_GrupoAlvo               (UM grupo, nunca dois)#(lf)        e o grupo alvo precisa existir, estar ativo e ter ao menos um membro#(lf)#(lf)    Pesquisa, resposta e classificacao: os passos [3] a [5] de#(lf)    consulta_coi_pesquisa_satisfacao_encerrados.sql, sem alteracao:#(lf)#(lf)        - uma pesquisa por chamado: a MAIS RECENTE (last_mod_dt desc, id desc),#(lf)          sem as excluidas (del = 0);#(lf)        - \"\"Com satisfacao\"\" = a pesquisa tem ao menos UMA opcao selecionada, em#(lf)          qualquer pergunta; senao \"\"Sem satisfacao\"\";#(lf)        - RespostaSatisfacao = a opcao selecionada na pergunta de ordem#(lf)          @SequenciaPerguntaAvaliada (padrao 40, satisfacao geral com a execucao#(lf)          dos servicos); NULL quando essa pergunta ficou em branco.#(lf)#(lf)    Equivalencia com a consulta original, para o mesmo periodo e grupo:#(lf)        contagem por StatusSatisfacao ............... = Janela 1#(lf)        linhas com RespostaSatisfacao preenchida ... = Janela 2#(lf)#(lf)COLUNAS DE SOLICITACAO DA PESQUISA - informativas, fora da classificacao#(lf)#(lf)    O SDM registra em dbo.act_log um evento SRVY_SENT (\"\"Solicitacao de pesquisa#(lf)    (...) enviada para ...\"\") quando dispara o pedido de pesquisa. Ele NAO cria,#(lf)    por si, uma instancia em dbo.survey: na medicao de 01/04/2026 a 01/10/2026#(lf)    (grupo COI_Novo), 2.242 dos 3.558 encerrados tem SRVY_SENT e so 2 tem#(lf)    pesquisa em dbo.survey, ambas respondidas.#(lf)#(lf)    Por isso ha duas leituras possiveis de \"\"quantidade de pesquisas\"\", e as duas#(lf)    ficam visiveis, sem misturar:#(lf)#(lf)        PesquisaSolicitada = 'Sim'          pedido de pesquisa registrado pelo SDM#(lf)        StatusSatisfacao = 'Com satisfação' pesquisa existente e respondida#(lf)                                            (a regra validada do COI)#(lf)#(lf)    PesquisaSolicitada, QtdSolicitacoesPesquisa, DataSolicitacaoPesquisa e#(lf)    SolicitacaoPesquisa NAO mudam StatusSatisfacao nem RespostaSatisfacao.#(lf)#(lf)DATAS#(lf)    DataEncerramento ......... close_date em horario do Brasil (eixo do periodo)#(lf)    DataPesquisa ............. last_mod_dt da pesquisa considerada; NULL sem#(lf)                               pesquisa#(lf)    DataSolicitacaoPesquisa .. o SRVY_SENT mais recente do chamado; NULL sem#(lf)                               solicitacao#(lf)    Ano, Mes, MesAno ......... da DataEncerramento; MesAno = AAAA-MM, que nao#(lf)                               depende do idioma do servidor#(lf)#(lf)DUPLICIDADE#(lf)    Uma linha por chamado, por construcao: a populacao sai de UMA passagem em#(lf)    call_req; #Pesquisa e #Satisfacao tem indice UNICO por chamado; as#(lf)    solicitacoes entram por #Solicitacao, tambem com indice UNICO por#(lf)    chamado.#(lf)#(lf)Somente leitura. Batch unico, sem GO.#(lf)================================================================================#(lf)*/#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- [0] PARAMETROS#(lf)--------------------------------------------------------------------------------#(lf)#(lf)-- Periodo em horario do Brasil, intervalo SEMIABERTO: >= inicio e < fim.#(lf)-- O fim e o PRIMEIRO INSTANTE DE FORA. Nunca usar 23:59:59.#(lf)-- [POWER BI] Periodo automatico, calculado no inicio do arquivo.#(lf)DECLARE @DataInicio datetime2(0) = @PBI_InicioBR;   -- inclusivo#(lf)DECLARE @DataFim    datetime2(0) = @PBI_FimBR;      -- EXCLUSIVO#(lf)#(lf)-- Identidade do COI. SEMPRE por UUID: nome de grupo muda, UUID nao.#(lf)DECLARE @COI_Antigo varbinary(16) = 0xDA7095D797E3FE498A62B79CB7EAED15;  -- 'Contrato 7/2023 - COI'#(lf)DECLARE @COI_Novo   varbinary(16) = 0x3C11B3A9EBCE5D498E2F7D7FF385F967;  -- 'COI'#(lf)#(lf)-- GRUPO ALVO: a unica linha que decide QUAL contrato esta sendo apurado.#(lf)--     producao / contrato vigente ............... @COI_Novo#(lf)--     conferencia do RSP de fevereiro/2026 ...... @COI_Antigo#(lf)-- NAO combinar os dois. NAO escolher automaticamente pela data.#(lf)DECLARE @COI_GrupoAlvo varbinary(16) = @COI_Novo;#(lf)#(lf)-- Qual pergunta da pesquisa vira a RespostaSatisfacao.#(lf)--   10 = O problema foi resolvido?            (Sim / Nao)#(lf)--   20 = Atendimento telefonico / teleoperador#(lf)--   30 = Atendimento do tecnico presencial#(lf)--   40 = Satisfacao GERAL com a execucao dos servicos   <-- padrao#(lf)--   50 = Satisfacao GERAL com o tempo de atendimento#(lf)DECLARE @SequenciaPerguntaAvaliada int = 40;#(lf)#(lf)DECLARE @HorasBrasilParaUTC int = 3;#(lf)DECLARE @Epoch datetime2(0) = '1970-01-01 00:00:00';#(lf)DECLARE @IniEpoch int = DATEDIFF(SECOND, @Epoch, DATEADD(HOUR, @HorasBrasilParaUTC, @DataInicio));#(lf)DECLARE @FimEpoch int = DATEDIFF(SECOND, @Epoch, DATEADD(HOUR, @HorasBrasilParaUTC, @DataFim));#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- [1] VALIDACAO DO GRUPO ALVO - identica a de consulta_coi_encerrados.sql.#(lf)--------------------------------------------------------------------------------#(lf)DECLARE @GrupoNome    nvarchar(200);#(lf)DECLARE @GrupoInativo int;#(lf)DECLARE @GrupoMembros bigint;#(lf)#(lf)SELECT#(lf)    @GrupoNome    = LTRIM(RTRIM(COALESCE(NULLIF(c.last_name, N''), NULLIF(c.userid, N''), N'(sem nome)'))),#(lf)    @GrupoInativo = c.inactive#(lf)FROM dbo.ca_contact AS c#(lf)WHERE c.contact_uuid = @COI_GrupoAlvo;#(lf)#(lf)SELECT @GrupoMembros = COUNT_BIG(*)#(lf)FROM dbo.grpmem AS gm#(lf)WHERE gm.group_id = @COI_GrupoAlvo;#(lf)#(lf)DECLARE @GrupoAlvoValido bit =#(lf)    CASE WHEN @GrupoNome IS NOT NULL AND @GrupoInativo = 0 AND @GrupoMembros > 0#(lf)         THEN 1 ELSE 0 END;#(lf)#(lf)IF @GrupoAlvoValido = 0#(lf)    PRINT N'ATENCAO: o grupo alvo NAO passa no filtro da Consulta para Auditoria '#(lf)        + N'(precisa existir, estar com inactive = 0 e ter ao menos um membro em grpmem). '#(lf)        + N'O resultado sera VAZIO por causa disso, e nao por ausencia de encerramentos.';#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- [2] POPULACAO - Encerrados pelo COI. O WHERE e o de consulta_coi_encerrados.sql#(lf)--     sem acrescimo nem supressao. persid e lido so para localizar o SRVY_SENT#(lf)--     em act_log; nao participa de filtro.#(lf)--------------------------------------------------------------------------------#(lf)IF OBJECT_ID('tempdb..#EncerradosCOI') IS NOT NULL DROP TABLE #EncerradosCOI;#(lf)#(lf)SELECT#(lf)    r.id,#(lf)    r.persid,#(lf)    r.ref_num AS SDM,#(lf)    r.[type]  AS tipo,#(lf)    DATEADD(HOUR, -@HorasBrasilParaUTC, DATEADD(SECOND, r.close_date, @Epoch)) AS encerramento_br#(lf)INTO #EncerradosCOI#(lf)FROM dbo.call_req AS r#(lf)WHERE r.close_date >= @IniEpoch#(lf)  AND r.close_date <  @FimEpoch#(lf)  AND r.[type]   IN ('I', 'R')#(lf)  AND r.status   IN ('CL', 'CLUNRSLV')#(lf)  AND r.group_id = @COI_GrupoAlvo#(lf)  AND @GrupoAlvoValido = 1#(lf)OPTION (RECOMPILE);#(lf)#(lf)CREATE UNIQUE CLUSTERED INDEX IX_EncerradosCOI ON #EncerradosCOI(id);#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- [3] UMA pesquisa por chamado: a mais recente. Igual a consulta original.#(lf)--------------------------------------------------------------------------------#(lf)IF OBJECT_ID('tempdb..#Pesquisa') IS NOT NULL DROP TABLE #Pesquisa;#(lf)#(lf)SELECT z.survey_id, z.call_req_id, z.last_mod_dt#(lf)INTO #Pesquisa#(lf)FROM (#(lf)    SELECT s.id AS survey_id, s.object_id AS call_req_id, s.last_mod_dt,#(lf)           ROW_NUMBER() OVER (PARTITION BY s.object_id#(lf)                              ORDER BY s.last_mod_dt DESC, s.id DESC) AS rn#(lf)    FROM dbo.survey AS s#(lf)    JOIN #EncerradosCOI AS e ON e.id = s.object_id#(lf)    WHERE s.object_type = N'cr'#(lf)      AND s.del = 0#(lf)) AS z#(lf)WHERE z.rn = 1;#(lf)#(lf)CREATE UNIQUE CLUSTERED INDEX IX_Pesquisa ON #Pesquisa(call_req_id);#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- [4] O que o usuario selecionou. Igual a consulta original.#(lf)--------------------------------------------------------------------------------#(lf)IF OBJECT_ID('tempdb..#Satisfacao') IS NOT NULL DROP TABLE #Satisfacao;#(lf)#(lf)SELECT#(lf)    p.call_req_id,#(lf)    p.survey_id,#(lf)    p.last_mod_dt,#(lf)    sel.qtd_opcoes_selecionadas,#(lf)    CONVERT(nvarchar(200), alvo.txt) AS resposta_avaliada#(lf)INTO #Satisfacao#(lf)FROM #Pesquisa AS p#(lf)CROSS APPLY (#(lf)    SELECT qtd_opcoes_selecionadas = COUNT(*)#(lf)    FROM dbo.survey_question AS q#(lf)    JOIN dbo.survey_answer AS a#(lf)        ON a.own_srvy_question = q.id#(lf)       AND a.selected = 1#(lf)    WHERE q.owning_survey = p.survey_id#(lf)) AS sel#(lf)OUTER APPLY (#(lf)    SELECT TOP (1) a2.txt#(lf)    FROM dbo.survey_question AS q2#(lf)    JOIN dbo.survey_answer AS a2#(lf)        ON a2.own_srvy_question = q2.id#(lf)       AND a2.selected = 1#(lf)    WHERE q2.owning_survey = p.survey_id#(lf)      AND q2.sequence = @SequenciaPerguntaAvaliada#(lf)    ORDER BY a2.sequence, a2.id#(lf)) AS alvo;#(lf)#(lf)CREATE UNIQUE CLUSTERED INDEX IX_Satisfacao ON #Satisfacao(call_req_id);#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- [5] SOLICITACAO DE PESQUISA - os eventos SRVY_SENT do proprio chamado em#(lf)--     act_log (call_req_id = persid), lidos UMA vez para a populacao inteira.#(lf)--     Fica uma linha por chamado: a contagem de todos e o mais recente, com#(lf)--     desempate system_time desc, id desc (o id e a ordem de gravacao no SDM).#(lf)--     Indice UNICO: se a premissa falhar, a criacao do indice falha em vez de#(lf)--     multiplicar o chamado no resultado.#(lf)--------------------------------------------------------------------------------#(lf)IF OBJECT_ID('tempdb..#Solicitacao') IS NOT NULL DROP TABLE #Solicitacao;#(lf)#(lf)SELECT z.id, z.qtd, z.system_time, z.texto#(lf)INTO #Solicitacao#(lf)FROM (#(lf)    SELECT#(lf)        e.id,#(lf)        al.system_time,#(lf)        LTRIM(RTRIM(CONVERT(nvarchar(400), al.[description]))) AS texto,#(lf)        COUNT(*) OVER (PARTITION BY e.id) AS qtd,#(lf)        ROW_NUMBER() OVER (PARTITION BY e.id ORDER BY al.system_time DESC, al.id DESC) AS rn#(lf)    FROM #EncerradosCOI AS e#(lf)    JOIN dbo.act_log AS al#(lf)        ON al.call_req_id = e.persid#(lf)    WHERE al.[type] = 'SRVY_SENT'#(lf)) AS z#(lf)WHERE z.rn = 1;#(lf)#(lf)CREATE UNIQUE CLUSTERED INDEX IX_Solicitacao ON #Solicitacao(id);#(lf)#(lf)--------------------------------------------------------------------------------#(lf)-- RESULTADO - uma linha por chamado encerrado pelo COI#(lf)--#(lf)-- #Satisfacao e #Solicitacao tem indice UNICO por chamado: os LEFT JOIN nao#(lf)-- multiplicam linha e nao removem chamado sem pesquisa ou sem solicitacao.#(lf)--------------------------------------------------------------------------------#(lf)SELECT#(lf)    e.SDM,#(lf)    CASE e.tipo WHEN 'I' THEN N'Incidente'#(lf)                WHEN 'R' THEN N'Solicitação'#(lf)                ELSE N'N/A' END                                          AS TipoChamado,#(lf)    e.encerramento_br                                                    AS DataEncerramento,#(lf)    YEAR(e.encerramento_br)                                              AS Ano,#(lf)    MONTH(e.encerramento_br)                                             AS Mes,#(lf)    CONVERT(char(7), CONCAT(YEAR(e.encerramento_br), N'-',#(lf)            RIGHT(CONCAT(N'0', MONTH(e.encerramento_br)), 2)))           AS MesAno,#(lf)    CONVERT(nvarchar(20), CASE WHEN ISNULL(s.qtd_opcoes_selecionadas, 0) > 0#(lf)                               THEN N'Com satisfação'#(lf)                               ELSE N'Sem satisfação' END)              AS StatusSatisfacao,#(lf)    @SequenciaPerguntaAvaliada                                           AS PerguntaAvaliada,#(lf)    s.resposta_avaliada                                                  AS RespostaSatisfacao,#(lf)    ISNULL(s.qtd_opcoes_selecionadas, 0)                                 AS QtdPerguntasRespondidas,#(lf)    CASE WHEN s.last_mod_dt IS NULL THEN NULL#(lf)         ELSE DATEADD(HOUR, -@HorasBrasilParaUTC, DATEADD(SECOND, s.last_mod_dt, @Epoch))#(lf)    END                                                                  AS DataPesquisa,#(lf)    CASE WHEN ISNULL(sol.qtd, 0) > 0 THEN N'Sim' ELSE N'Não' END         AS PesquisaSolicitada,#(lf)    ISNULL(sol.qtd, 0)                                                   AS QtdSolicitacoesPesquisa,#(lf)    CASE WHEN sol.system_time IS NULL THEN NULL#(lf)         ELSE DATEADD(HOUR, -@HorasBrasilParaUTC, DATEADD(SECOND, sol.system_time, @Epoch))#(lf)    END                                                                  AS DataSolicitacaoPesquisa,#(lf)    sol.texto                                                            AS SolicitacaoPesquisa#(lf)FROM #EncerradosCOI AS e#(lf)LEFT JOIN #Satisfacao AS s#(lf)    ON s.call_req_id = e.id#(lf)LEFT JOIN #Solicitacao AS sol#(lf)    ON sol.id = e.id#(lf)ORDER BY#(lf)    e.encerramento_br,#(lf)    e.SDM;#(lf)\",\n    Fonte = #\"Executar consulta COI\"(Sql),\n    ComDia = Table.AddColumn(Fonte, \"DataEncerramento (dia)\", each Date.From([DataEncerramento]), type date)\nin\n    ComDia"
            }
          }
        ],
        "annotations": [
