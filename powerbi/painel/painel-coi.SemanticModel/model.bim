          },
          {
            "type": "calculatedTableColumn",
            "name": "Mês/Ano",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Mês/Ano]",
            "summarizeBy": "none",
            "lineageTag": "b1a1e189-7f1c-7c66-3c1f-aa4a41dfd19b",
            "sortByColumn": "AnoMes"
          },
          {
            "type": "calculatedTableColumn",
            "name": "AnoMes",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[AnoMes]",
            "summarizeBy": "none",
            "lineageTag": "7ac66098-c116-832b-6a8b-99c746bc63f4",
            "formatString": "0",
            "isHidden": true
          },
          {
            "type": "calculatedTableColumn",
            "name": "Mês/Ano (seleção)",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Mês/Ano (seleção)]",
            "summarizeBy": "none",
            "lineageTag": "6bb88b98-a86c-e4d1-a855-02c82da00cae",
            "sortByColumn": "Ordem seleção",
            "description": "Igual a Mês/Ano, mas o último mês carregado se chama \"Último mês completo\": a seleção padrão das páginas de mês único acompanha cada atualização."
          },
          {
            "type": "calculatedTableColumn",
            "name": "Ordem seleção",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Ordem seleção]",
            "summarizeBy": "none",
            "lineageTag": "d53ded9b-8324-51a3-7747-2cb1caac16d9",
            "formatString": "0",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Calendário COI",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "VAR Inicio = MIN ( 'Movimentação Diária'[Dia] )\nVAR Fim = MAX ( 'Movimentação Diária'[Dia] )\nVAR UltimoAnoMes = YEAR ( Fim ) * 100 + MONTH ( Fim )\nRETURN\n    SELECTCOLUMNS (\n        CALENDAR ( Inicio, Fim ),\n        \"Data\", [Date],\n        \"Ano\", YEAR ( [Date] ),\n        \"Mês nº\", MONTH ( [Date] ),\n        \"Mês\", SWITCH ( MONTH ( [Date] ), 1, \"jan\", 2, \"fev\", 3, \"mar\", 4, \"abr\", 5, \"mai\", 6, \"jun\", 7, \"jul\", 8, \"ago\", 9, \"set\", 10, \"out\", 11, \"nov\", 12, \"dez\" ),\n        \"Mês/Ano\", SWITCH ( MONTH ( [Date] ), 1, \"jan\", 2, \"fev\", 3, \"mar\", 4, \"abr\", 5, \"mai\", 6, \"jun\", 7, \"jul\", 8, \"ago\", 9, \"set\", 10, \"out\", 11, \"nov\", 12, \"dez\" ) & \"/\" & YEAR ( [Date] ),\n        \"AnoMes\", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),\n        \"Mês/Ano (seleção)\",\n            IF ( YEAR ( [Date] ) * 100 + MONTH ( [Date] ) = UltimoAnoMes, \"Último mês completo\",\n                 SWITCH ( MONTH ( [Date] ), 1, \"jan\", 2, \"fev\", 3, \"mar\", 4, \"abr\", 5, \"mai\", 6, \"jun\", 7, \"jul\", 8, \"ago\", 9, \"set\", 10, \"out\", 11, \"nov\", 12, \"dez\" ) & \"/\" & YEAR ( [Date] ) ),\n        \"Ordem seleção\",\n            IF ( YEAR ( [Date] ) * 100 + MONTH ( [Date] ) = UltimoAnoMes, 0,\n                 1000000 - ( YEAR ( [Date] ) * 100 + MONTH ( [Date] ) ) )\n    )"
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Ano › Mês › Dia",
            "lineageTag": "0deba34d-9feb-fa8d-b3ee-b43965278d0e",
