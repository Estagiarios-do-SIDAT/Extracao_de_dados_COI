    "expressions": [
      {
        "name": "QtdMesesCompletosCOI",
        "kind": "m",
        "lineageTag": "16065c20-d5dd-e0c5-a13d-5b57319aeacd",
        "description": "Quantidade máxima de meses completos carregados pelas seis consultas (inteiro positivo). Nunca antes de 01/03/2026.",
        "expression": "12 meta [IsParameterQuery = true, IsParameterQueryRequired = true, Type = \"Number\"]",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Number"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navegação"
          }
        ]
      },
      {
        "name": "Executar consulta COI",
        "kind": "m",
        "lineageTag": "29544a64-5927-9da5-dc8e-89dba7adf77f",
        "description": "Valida QtdMesesCompletosCOI, troca a linha do período pelo parâmetro SQL @QtdMesesCompletosCOI e executa o SQL no bdados-14r/mdb.",
        "expression": "(TextoSql as text) as table =>\nlet\n    Qtd = QtdMesesCompletosCOI,\n    QtdValida =\n        if Value.Is(Qtd, type number) and Qtd >= 1 and Qtd = Number.RoundDown(Qtd)\n        then Int64.From(Qtd)\n        else error Error.Record(\"QtdMesesCompletosCOI inválido\",\n            \"Informe um número inteiro positivo de meses completos (por exemplo, 12).\", Qtd),\n    Marcador = \"DECLARE @PBI_QuantidadeMeses int = 12;\",\n    Ocorrencias = List.Count(Text.PositionOf(TextoSql, Marcador, Occurrence.All)),\n    TextoParametrizado =\n        if Ocorrencias = 1\n        then Text.Replace(TextoSql, Marcador, \"DECLARE @PBI_QuantidadeMeses int = @QtdMesesCompletosCOI;\")\n        else error Error.Record(\"Consulta COI sem o marcador de período\",\n            \"A linha \" & Marcador & \" deve aparecer uma única vez no SQL.\", Ocorrencias),\n    Fonte = Value.NativeQuery(\n        Sql.Database(\"bdados-14r\", \"mdb\"),\n        TextoParametrizado,\n        [QtdMesesCompletosCOI = QtdValida]),\n    // Colunas binárias (UUIDs) não são carregáveis no modelo: viram texto hexadecimal.\n    Binarias = List.Select(Table.ColumnNames(Fonte),\n        (c) => Type.Is(Type.NonNullable(Type.TableColumn(Value.Type(Fonte), c)), type binary)),\n    Resultado = Table.TransformColumns(Fonte,\n        List.Transform(Binarias, (c) => {c, (b) => if b = null then null else Binary.ToText(b, BinaryEncoding.Hex), type nullable text}))\nin\n    Resultado",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navegação"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_QueryOrder",
        "value": "[\"QtdMesesCompletosCOI\", \"Executar consulta COI\", \"Chamados Registrados\", \"Chamados Encerrados\", \"Movimentação Diária\", \"Movimentação por Hora\", \"Movimentação por Membro\", \"Pesquisas de Satisfação\", \"Última Atualização\", \"Documentação COI\"]"
      },
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      }
    ]
  }
